---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t as ct, tf } from '../data/copy';
import { SITE } from '../consts';
import { countCombat, countCombatWords, countImages } from '../data/counts';
import '../styles/menu-glitch.css';
import '../styles/boot.css';
import '../styles/title-look3.css';
import '../styles/title-breath.css';

// 副标题可以在后台「首页 · 文案」里改
const home = await getEntry('home', 'home');
const role = home?.data.subtitle || ct('home.role.fallback', '动作游戏战斗策划');

// 标题画面上的名字（视频那里是 NieR:Automata，这里是自己的）
const LOGO = 'HuangChenRui';

// 五项菜单：阿比斯带 signal 动效，和其它项一样可点
const menuAll = [
  { label: ct('home.nav.brief', '简介'), href: '/brief/' },
  { label: ct('home.nav.works', '作品'), href: '/works/' },
  { label: ct('home.nav.articles', '文章'), href: '/articles/' },
  { label: ct('home.nav.contact', '联系'), href: '/about/' },
  { label: ct('home.nav.abyss', '阿比斯'), href: '/abyss/', signal: true },
];

// 阿比斯和其它项一样：只是个入口，带信号动效，点进去到 /abyss/
// （游戏本体是否开放由 /abyss/ 那页自己说，菜单上不再挂「未开放」）
const menu = menuAll;

// 右下角的联系方式：B 站 / GitHub / 邮件
const social = [
  ...SITE.links.map((l) => ({ label: l.label, href: l.href })),
  { label: ct('home.social.mail', '邮件'), href: `mailto:${SITE.email}` },
];

/* 自检行：一句一行，像机器在自言自语。
 * 带数字的几行都是**真数**（src/data/counts.ts 现算），没数据源的只写动作词，不编数字。
 * 「权限等级」这行的数字由脚本按 localStorage 覆盖，默认 4。 */
const bootLines = [
  ct('home.boot.0', '系统检查开始'),
  tf('home.boot.1', { n: 4 }, '权限等级：{n}'),
  tf('home.boot.2', { n: countCombat() }, '文章索引：{n} 章 · 通过'),
  tf('home.boot.3', { n: (countCombatWords() / 10000).toFixed(1) }, '拆解字数：{n} 万 · 已读入'),
  tf('home.boot.4', { n: 5 }, '作品档案：{n} 项 · 已挂载'),
  tf('home.boot.5', { n: countImages() }, '素材库：{n} 张 · 已索引'),
  ct('home.boot.6', '体验记录：已归档'),
  ct('home.boot.7', 'Boss 模组：已解析'),
  ct('home.boot.8', '帧数档位：已载入'),
  ct('home.boot.9', '打击反馈：顿帧 / 震屏 · 就绪'),
  ct('home.boot.10', '韧性规则：已上线'),
  ct('home.boot.11', '可玩验证：阿比斯 v0.6 · 通过'),
  ct('home.boot.12', '渲染管线：准备中'),
  ct('home.boot.13', 'MP 残量检查：100%'),
  ct('home.boot.14', '战斗准备完成'),
];

// 乱码行用的原始串（自己的字）
const FAULT_TEXT = ct('home.fault', 'PORTFOLIO · HUANG CHENRUI · 战斗策划');

/* V3 示意用的尘埃：手写死的坐标（不用随机数，截图才稳定）。
   都是"近景"粒子：大、慢、糊，和远处的星空区分开。 */
const dust = [
  { x: 8, y: 62, s: 2, d: 26, delay: 3, o: 0.35 },
  { x: 15, y: 38, s: 3, d: 34, delay: 12, o: 0.22 },
  { x: 22, y: 74, s: 2, d: 22, delay: 7, o: 0.4 },
  { x: 29, y: 48, s: 4, d: 40, delay: 19, o: 0.16 },
  { x: 36, y: 66, s: 2, d: 28, delay: 2, o: 0.3 },
  { x: 44, y: 32, s: 3, d: 36, delay: 15, o: 0.2 },
  { x: 51, y: 72, s: 2, d: 24, delay: 9, o: 0.34 },
  { x: 58, y: 44, s: 5, d: 44, delay: 24, o: 0.12 },
  { x: 63, y: 60, s: 2, d: 27, delay: 5, o: 0.3 },
  { x: 69, y: 36, s: 3, d: 38, delay: 17, o: 0.18 },
  { x: 74, y: 70, s: 2, d: 23, delay: 11, o: 0.36 },
  { x: 80, y: 52, s: 4, d: 42, delay: 21, o: 0.14 },
  { x: 86, y: 64, s: 2, d: 29, delay: 6, o: 0.28 },
  { x: 91, y: 40, s: 3, d: 35, delay: 13, o: 0.2 },
  { x: 95, y: 76, s: 2, d: 25, delay: 8, o: 0.32 },
];

const year = new Date().getFullYear();
---

<Base title={SITE.title} description={SITE.intro} bodyClass="mode-fun title-page" mainClass="title-main" hideNav>
  <script is:inline>
    (function () {
      // 播不播自检：
      //   首次进站      → 播
      //   F5 刷新       → 播（刷新就是想再看一遍）
      //   站内切回/返回 → 不播
      var KEY = 'hcr:boot:in';
      var q = location.search;
      var skip = q.indexOf('boot=0') > -1;
      var force = q.indexOf('boot=1') > -1;

      var inside = false;
      try {
        inside = sessionStorage.getItem(KEY) === '1';
      } catch (e) {}

      // 区分「刷新」和「站内跳转」：刷新是 reload，点链接是 navigate
      var navType = 'navigate';
      try {
        var nav = performance.getEntriesByType('navigation')[0];
        if (nav && nav.type) navType = nav.type;
      } catch (e) {}

      var play = force || (!skip && (navType === 'reload' || !inside));

      try {
        sessionStorage.setItem(KEY, '1');
      } catch (e) {}

      document.documentElement.setAttribute('data-boot', play ? 'play' : 'skip');
    })();
  </script>

<script>
  /*
   * 阿比斯：点了不跳转，演一段「信号不清晰 → 信号中断」，然后这一项消失。
   * 本次会话内不再出现（sessionStorage），新开标签页照旧出现。
   * 断网 / 关掉 JS 时它是普通链接，落到 /abyss/ 那句「信号中断」页——兜底还算合理。
   */
  import { sfx } from '../scripts/sfx';
  import { t as ct } from '../data/copy';

  const abyss = document.querySelector<HTMLElement>('[data-abyss]');
  const LOST_KEY = 'hcr:abyss:lost';
  const markLost = () => {
    document.documentElement.classList.add('abyss-lost');
    try {
      sessionStorage.setItem(LOST_KEY, '1');
    } catch {
      /* 隐私模式下存不了，本次会话内 still 靠 DOM 状态 */
    }
  };

  let alreadyLost = false;
  // ?reset=1 一键清掉"这一轮失联"的记忆（阿比斯 + 未公开条目），方便反复测试
  try {
    if (new URLSearchParams(location.search).get('reset') === '1') {
      sessionStorage.removeItem(LOST_KEY);
      sessionStorage.removeItem('hcr:locked:gone');
      document.documentElement.classList.remove('abyss-lost');
    }
  } catch {
    /* 隐私模式 */
  }
  try {
    alreadyLost = sessionStorage.getItem(LOST_KEY) === '1';
  } catch {
    alreadyLost = false;
  }
  if (alreadyLost) markLost();

  if (abyss) {
    const label = abyss.querySelector<HTMLElement>('.t');
    const base = label?.textContent?.trim() || ct('home.nav.abyss', '阿比斯');
    const NOISE = '▓▒░▚▞⌁≠≡∷';

    const noise = () =>
      [...base].map(() => NOISE[Math.floor(Math.random() * NOISE.length)]).join('');

    abyss.addEventListener('click', (event) => {
      event.preventDefault();
      if (abyss.dataset.lost === '1') return;
      abyss.dataset.lost = '1';

      sfx.tv();

      const gone = () => {
        abyss.remove();
        markLost();
      };

      if (reduce) {
        gone();
        return;
      }

      // 先把重影层卸掉：它们带的是旧字，留着会和新字打架，也很费合成器
      abyss.querySelectorAll('.sig-band, .sig-fringe').forEach((node) => node.remove());
      abyss.classList.add('is-losing');

      // 1) 信号不清晰：文字被打散（只换三次，不用 setInterval）
      if (label) label.textContent = noise();
      window.setTimeout(() => label && (label.textContent = noise()), 130);
      window.setTimeout(() => label && (label.textContent = noise()), 260);

      // 2) 信号中断
      window.setTimeout(() => {
        if (label) label.textContent = ct('home.signal.break', '信号中断');
        abyss.classList.add('is-dead');
        sfx.signalLost();
      }, 520);

      // 3) 塌掉 → 摘点
      window.setTimeout(() => abyss.classList.add('is-gone'), 900);
      window.setTimeout(gone, 1320);
    });

    // 键盘回车等价于点击
    abyss.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      abyss.click();
    });
  }
</script>

  <div class="tp" data-tp data-state="boot" data-phase="1">
    <!-- 首屏黑幕：1 秒淡出，屏"亮起来"之后才出 LOADING -->
    <div class="tp-veil" aria-hidden="true"></div>
    <!-- 自检时背后的水印：靠右，避开左边的日志栏；进标题帧就退场 -->
    <div class="tp-mark" aria-hidden="true">
      <b>HuangChenRui</b>
      <em>for the record</em>
    </div>

    <!-- 场景：星空 / 水面 / 雾 / 插在水里的刀 -->
    <div class="tp-scene">
      <canvas class="tp-sky" data-sky aria-hidden="true"></canvas>
      <div class="tp-haze" aria-hidden="true"></div>
      <div class="tp-water" aria-hidden="true"></div>

      <div class="tp-horizon" aria-hidden="true"></div>
    </div>

    <!-- 屏幕质感 -->
    <div class="tp-grain" aria-hidden="true"></div>
    <div class="tp-crt" aria-hidden="true"></div>
    <div class="tp-scan" aria-hidden="true"></div>
    <div class="tp-vignette" aria-hidden="true"></div>
    <div class="tp-flicker" aria-hidden="true"></div>

    <!-- ============================================================
         V3「仪式」示意层：默认全部隐藏，加 ?look=3 才出现。
         只叠层，不改原有结构 —— 随时能整体摘掉。
         前景剪影 / 发光核心 / 尘埃 / 呼吸 / 推镜
         ============================================================ -->
    <div class="tp-dust" aria-hidden="true">
      {dust.map((d) => (
        <i
          style={`--x:${d.x}%;--y:${d.y}%;--s:${d.s}px;--d:${d.d}s;--delay:-${d.delay}s;--o:${d.o}`}
        />
      ))}
    </div>
    <div class="tp-core" aria-hidden="true"></div>
    <div class="tp-fore" aria-hidden="true">
      <svg viewBox="0 0 1440 160" preserveAspectRatio="none" focusable="false">
        <path d="M0,96 C120,78 210,104 320,92 C430,80 500,112 620,100 C740,88 830,116 950,102 C1070,88 1150,110 1260,98 C1330,90 1390,100 1440,94 L1440,160 L0,160 Z" />
      </svg>
    </div>
    <div class="tp-breathe" aria-hidden="true"></div>

    <div class="tp-blackout" aria-hidden="true"></div>

    <!-- 自检层 -->
    <div class="tp-loading"><span class="l1">{ct('home.loading.1', 'LOADING')}</span><span class="l2">{ct('home.loading.2', '_ 系统启动中..')}</span></div>
    <div class="tp-log" data-log>
      {bootLines.map((line) => <div class="bl" data-text={line}>{line}</div>)}
    </div>

    <!-- 系统读取中：上下黑压压，中间一条横带，左右各一组同心圆线 -->
    <div class="tp-read" aria-hidden="true">
      <i class="l"></i>
      <i class="r"></i>
      <span>{ct('home.reading', '系统读取中')}</span>
    </div>

    <!-- 乱码帧：只有一行小字，带色散 -->
    <div class="tp-fault" aria-hidden="true">
      <span class="ft" data-fault></span>
    </div>

    <!-- 标题：字压在轴线上。
         色散层（红/青副本）垫在字下面；横切带在"爆发"那几帧把字切成横条。 -->
    <h1 class="tp-word">
      <span class="chroma" aria-hidden="true">
        <span class="r">{LOGO}</span>
        <span class="c">{LOGO}</span>
      </span>
      <span class="w-a">{LOGO}</span>
      <span class="w-b" aria-hidden="true">{LOGO}</span>
      <!-- 反白块：右段整块刷白，字母在块里被挖空 -->
      <span class="w-slab" aria-hidden="true">
        <span class="w-slab-bg"></span>
        <span class="w-slab-txt">{LOGO}</span>
      </span>
      <span class="w-blocks" aria-hidden="true">
        {Array.from({ length: 6 }, () => <i />)}
      </span>
      <span class="slice" aria-hidden="true"><span>{LOGO}</span></span>
    </h1>

    <!-- V3：标题下面那行像游戏版本号的极小事（默认隐藏，?look=3 才显示） -->
    <p class="tp-ver" aria-hidden="true">v0.6 · 第 6 次迭代 · 2026</p>

    <!-- PRESS：原版结构 —— 一行小字 + 正下方一条两端带圆点的细线 -->
    <p class="tp-action tp-press" data-press>
      <span class="txt-wrap">
        <span class="smear" aria-hidden="true"></span>
        <span class="txt" data-type="Press Any Button"></span>
      </span>
      <span class="pressline" aria-hidden="true"></span>
      <span class="streak" aria-hidden="true">
        {Array.from({ length: 10 }, () => <i />)}
      </span>
    </p>

    <!-- 点过之后：同一行换成菜单。五项全会话可点，阿比斯带信号动效 -->
    <nav class="tp-menu" aria-label="主导航">
      {
        menu.map((item, i) => (
          <a
            href={item.href}
            class:list={[item.signal && 'is-signal']}
            data-dive={item.signal ? undefined : 'on'}
            data-abyss={item.signal ? '' : undefined}
          >
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span class="t">{item.label}</span>
          </a>
        ))
      }
    </nav>

    <!--
      页脚：一行两块，同一基线。
      左 = 落款（版权 + 身份），右 = 联系方式。
      音量小格子已经删掉：音量拖这条主轴（地平线）或按 ← → 就能调，
      页面里再放一排格子属于同一件事说两遍。
    -->
    <footer class="tp-foot">
      <span class="tp-credit">© {year} {SITE.cnName} · {role}</span>
      <span class="tp-social">
        {
          social.map((item) => (
            <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              {item.label}
            </a>
          ))
        }
      </span>
    </footer>
  </div>
</Base>

<script>
  import '../scripts/menu-glitch';
  import { initSky, initCorruption, startFault } from '../scripts/title-scene';
  import { initTitleBreath } from '../scripts/title-breath';
  import { t as ct } from '../data/copy';
  import { initBgm, startBgmWhenReady, fadeOutBgm } from '../scripts/bgm';

  const tp = document.querySelector<HTMLElement>('[data-tp]');
  const root = document.documentElement;

  /* 降级已移除：这个站永远走完整动效（用户明确要求：有且只有动效）。 */
  const reduce = false;

  if (tp) {
    const KEY = 'hcr:boot:v1';
    /* ---------------- 音乐：只在标题画面起播 ----------------
     * 加载/自检那一段不响（用户明确要求）。所以在标题帧落位的地方调这里，
     * 而不是在页面一加载就初始化。渐入 2.4s，见 scripts/bgm.ts。 */
    let musicOn = false;
    const startTitleMusic = (): void => {
      if (musicOn) return;
      musicOn = true;
      const src = document.body.dataset.bgm || '';
      if (!src) return;
      initBgm(src, Number(document.body.dataset.bgmVolume) || 0.22);
      startBgmWhenReady();
    };

    // 点菜单离开首页时先渐出 320ms，别硬切
    for (const link of tp.querySelectorAll<HTMLAnchorElement>('.tp-menu a:not([data-abyss])')) {
      link.addEventListener('click', () => fadeOutBgm(320));
    }

    /* V3「仪式」示意：?look=3 打开、?look=0 关掉（只加层，不动结构） */
    try {
      const look = new URLSearchParams(location.search).get('look');
      if (look === '3') tp.setAttribute('data-look', '3');
    } catch {
      /* 无所谓 */
    }

    /* 标题呼吸：?breath=1 跟音乐，?breath=demo 假呼吸（看效果用） */
    try {
      const mode = new URLSearchParams(location.search).get('breath');
      if (mode === 'demo') initTitleBreath('demo');
      else if (mode === '1') initTitleBreath('audio');
    } catch {
      /* 无所谓 */
    }

    const lines = [...tp.querySelectorAll<HTMLElement>('.bl')];
    const logEl = tp.querySelector<HTMLElement>('[data-log]');
    const pressEl = tp.querySelector<HTMLElement>('[data-press]');

    /* 权限等级：纯叙事，默认 4。访问 ?lv=10 会写进 localStorage，下次开机还是 10。
     * 它不控制任何内容的可见性（真东西根本不在产物里），只改这一行自检文案。 */
    let LEVEL = 4;
    try {
      const q = new URLSearchParams(location.search).get('lv');
      if (q && /^\d{1,2}$/.test(q)) localStorage.setItem('hcr:lv', q);
      LEVEL = Number(localStorage.getItem('hcr:lv')) || 4;
    } catch {
      /* 隐私模式：就用默认值 */
    }
    const lvLine = [...tp.querySelectorAll<HTMLElement>('.bl')].find((el) =>
      (el.dataset.text ?? el.textContent ?? '').startsWith('权限等级'),
    );
    if (lvLine) {
      const text = `权限等级：${LEVEL}`;
      lvLine.dataset.text = text;
      lvLine.textContent = text;
    }
    const wordEl = tp.querySelector<HTMLElement>('.tp-word');
    const faultEl = tp.querySelector<HTMLElement>('[data-fault]');
    const skyEl = tp.querySelector<HTMLCanvasElement>('[data-sky]');
    const timers: number[] = [];
    let phase = 1;
    let done = false;
    let aborted = false;

    const sleep = (ms: number) =>
      new Promise<void>((resolve) => {
        // 不登记进 timers：这是序列自己的节拍，被 clearTimers 掐掉的话
        // await 永远不 resolve，序列就卡在「黑场」那一步，屏幕再也不会亮回来。
        window.setTimeout(resolve, ms);
      });

    const setPhase = (n: number) => {
      phase = n;
      tp.setAttribute('data-phase', String(n));
    };

    const clearTimers = () => {
      while (timers.length) window.clearTimeout(timers.pop());
    };

    /* ---------------- LOADING 那行：点点自己跳 ----------------
     * 静态的「系统启动中..」很生硬，改成 1 → 2 → 3 个点循环，
     * 节拍跟主机读盘的指示灯差不多（320ms 一格）。
     */
    const dotsEl = tp.querySelector<HTMLElement>('.tp-loading .l2');
    const DOTS_BASE = '_ 系统启动中';
    let dotTimer = 0;
    let dotStep = 1;

    const paintDots = () => {
      if (!dotsEl) return;
      dotsEl.textContent = DOTS_BASE + '.'.repeat(dotStep);
    };

    const startDots = () => {
      if (!dotsEl || dotTimer) return;
      dotStep = 1;
      paintDots();
      dotTimer = window.setInterval(() => {
        dotStep = dotStep >= 3 ? 1 : dotStep + 1;
        paintDots();
      }, 320);
    };

    const stopDots = () => {
      if (!dotTimer) return;
      window.clearInterval(dotTimer);
      dotTimer = 0;
    };

    /* ---------------- 星空 + 常驻腐蚀 + 标题色散 ---------------- */

    if (skyEl) initSky(skyEl);
    if (wordEl) initCorruption(wordEl, tp);
    startLogoChroma();

    /* ---------------- 音量 ---------------- */
    /* ---------------- 地平线（只作视觉轴，不再是音量条） ---------------- */

    // 音量/键盘调节已经撤掉：地平线现在只是那条横线，--vol 固定 0.5 给雾和水面定量。
    tp.style.setProperty('--vol', '0.5');

    /* ---------------- 自检：逐字打出来（参考的做法） ----------------
     * 每行从左往右长，14ms/字；前沿会随机闪一个"错字"（参考里就是先错后对）。
     * 行与行之间 118ms，首行之后先停 0.7 秒再开始刷屏。
     */
    const CHAR_MS = 30;
    const WRONG_POOL = '系统检查读取载入索引通过档位模组素材记录验证渲染战备完成';

    const lineStart = new WeakMap<HTMLElement, number>();
    let typingOn = false;

    const typeTick = () => {
      if (!typingOn) return;
      const now = performance.now();
      for (const el of lines) {
        const t0 = lineStart.get(el);
        if (t0 === undefined) continue;
        const full = el.dataset.text ?? '';
        const n = Math.floor((now - t0) / CHAR_MS);
        if (n >= full.length) {
          if (el.textContent !== full) el.textContent = full;
          continue;
        }
        const ghost = Math.random() < 0.4 ? WRONG_POOL[Math.floor(Math.random() * WRONG_POOL.length)] : '';
        el.textContent = full.slice(0, Math.max(0, n)) + ghost;
      }
      window.requestAnimationFrame(typeTick);
    };

    const startLogTyping = () => {
      typingOn = true;
      for (const el of lines) el.textContent = '';
      window.requestAnimationFrame(typeTick);
    };

    const fillAll = () => {
      typingOn = false;
      for (const el of lines) {
        el.textContent = el.dataset.text ?? '';
        el.classList.add('on');
      }
      logEl?.classList.remove('is-out');
      tp.querySelector('.tp-loading')?.classList.remove('is-out');
    };

    const FAULT_TEXT = ct('home.fault', 'PORTFOLIO · HUANG CHENRUI · 战斗策划');

    /* ---------------- 逐行错位：某一条扫描线偶尔"失锁" ----------------
     * 照视频实测抄的参数：
     *   · 每行约 0.38 次/秒，也就是平均 2.6 秒滑一下
     *   · 每次持续 1~3 帧（40~120ms）就弹回
     *   · 幅度固定 -1 或 -2px，整数跳，而且要"只往左"
     *   · 只错已经定型的行（正在淡入的那行本来就在动，再抖就乱）
     * 用独立的 translate 属性而不是 transform，免得和淡入的 translateY 打架。
     */
    const startWobble = (): (() => void) => {
      if (reduce) return () => {};

      const settled = new WeakMap<HTMLElement, number>();
      let stopped = false;

      const tick = () => {
        if (stopped) return;
        if (phase !== 1) {
          // 自检层已经退场，收尾
          for (const el of lines) {
            el.style.translate = '';
            el.classList.remove('is-wob');
          }
          return;
        }
        const now = performance.now();
        for (const el of lines) {
          if (!el.classList.contains('on')) continue;
          const born = settled.get(el);
          if (born === undefined) {
            settled.set(el, now);
            continue;
          }
          if (now - born < 420) continue; // 还在淡入/刚定型
          if (Math.random() < 0.38 * 0.08) {
            const dx = Math.random() < 0.5 ? -1 : -2;
            el.style.translate = `${dx}px 0`;
            el.classList.add('is-wob');
            window.setTimeout(() => {
              el.style.translate = '';
              el.classList.remove('is-wob');
            }, 40 + Math.random() * 80);
          }
        }
        window.setTimeout(tick, 80);
      };

      tick();
      return () => {
        stopped = true;
        for (const el of lines) {
          el.style.translate = '';
          el.classList.remove('is-wob');
        }
      };
    };

    /* ---------------- 标题的色散与抖动 ----------------
     * 参考里 logo 是"两档"：
     *   稳定  明显色偏的亮像素约 1.2%（红/青各偏 0.6~0.9px）
     *   爆发  约 10%（偏到 2px，同时横切一刀 + 整体错 1px），持续 2~4 帧
     * 用两份染色文字副本 + blur 去做，出来的彩边是糊的，像色度抽样。
     */
    function startLogoChroma(): () => void {
      if (reduce) return () => {};
      const chroma = wordEl?.querySelector<HTMLElement>('.chroma');
      const red = chroma?.querySelector<HTMLElement>('.r');
      const cyan = chroma?.querySelector<HTMLElement>('.c');
      const slice = wordEl?.querySelector<HTMLElement>('.slice');
      if (!wordEl || !red || !cyan || !slice) return () => {};

      let stopped = false;
      let burst = 0;
      let next = 14 + Math.floor(Math.random() * 12);

      const tick = () => {
        if (stopped) return;
        window.setTimeout(tick, 40);
        if (document.hidden) return;

        if (burst > 0) burst -= 1;
        else if (--next <= 0) {
          burst = 2 + Math.floor(Math.random() * 3);
          next = 26 + Math.floor(Math.random() * 16);
        }
        const hot = burst > 0;

        // 红/青各偏多少
        const cx = hot ? 1.7 + Math.random() * 0.7 : 0.55 + Math.random() * 0.35;
        const alpha = hot ? 0.42 : 0.15;
        const blur = hot ? 1.15 : 0.65;
        red.style.transform = `translateX(${(-cx).toFixed(2)}px)`;
        cyan.style.transform = `translateX(${cx.toFixed(2)}px)`;
        red.style.opacity = String(alpha);
        cyan.style.opacity = String(alpha);
        red.style.filter = `blur(${blur}px)`;
        cyan.style.filter = `blur(${blur}px)`;

        // 爆发：切一条横带错开 + 整体错 1px
        if (hot) {
          slice.style.display = 'block';
          const top = 22 + Math.random() * 46;
          const h = 4 + Math.random() * 9;
          slice.style.clipPath = `inset(${top.toFixed(0)}% 0 ${(100 - top - h).toFixed(0)}% 0)`;
          slice.style.transform = `translateX(${((Math.random() < 0.5 ? -1 : 1) * (1 + Math.random() * 2)).toFixed(1)}px)`;
          wordEl.style.transform = `translate(-50%, -0.022em) translateX(${(Math.random() < 0.5 ? -1 : 1)}px)`;
        } else {
          slice.style.display = 'none';
          wordEl.style.transform = 'translate(-50%, -0.022em)';
        }
      };

      tick();
      return () => {
        stopped = true;
        if (slice) slice.style.display = 'none';
      };
    }

    const runSequence = async () => {
      // ① 只有 LOADING 的空镜（CSS 负责淡入）
      startDots();
      startLogTyping();
      // 黑幕 1s 淡出 → LOADING 1s 起淡入 0.8s（1800ms 到位）→ 再停 200ms
      await sleep(2000);
      if (aborted) return;

      // ② 首行先单独出，停 0.7 秒，然后逐行刷：
      //    一行打完才起下一行（严格串行，不叠在一起打）
      const [first, ...rest] = lines;
      const typeLine = async (el: HTMLElement) => {
        el.classList.add('on');
        lineStart.set(el, performance.now());
        const len = (el.dataset.text ?? '').length;
        await sleep(len * CHAR_MS + 50);
      };

      if (first) await typeLine(first);
      await sleep(700);
      for (const el of rest) {
        if (aborted) return;
        await typeLine(el);
      }

      // ③ 满屏停留
      await sleep(2300);
      if (aborted) return;

      // ④ 整块淡出
      typingOn = false;
      stopDots();
      tp.querySelector('.tp-loading')?.classList.add('is-out');
      logEl?.classList.add('is-out');
      await sleep(860);
      if (aborted) return;

      // ⑤ 黑场
      tp.classList.add('is-blackout');
      await sleep(680);
      if (aborted) return;

      // ⑥ 系统读取中
      tp.classList.remove('is-blackout');
      setPhase(2);
      await sleep(1500);
      if (aborted) return;

      // ⑦ 黑场 → 一行乱码
      tp.classList.add('is-blackout');
      setPhase(3);
      await sleep(420);
      if (aborted) return;
      tp.classList.remove('is-blackout');
      const stopFault = faultEl ? startFault(faultEl, FAULT_TEXT) : () => {};
      await sleep(1250);
      stopFault();
      if (aborted) return;

      // ⑧ 标题闪入
      tp.classList.add('is-blackout');
      setPhase(4);
      await sleep(280);
      if (aborted) return;
      tp.classList.remove('is-blackout');
      tp.classList.add('is-flash');
      await sleep(480);
      tp.classList.remove('is-flash');
      tp.classList.add('is-grown');
      startTitleMusic();
      void typePress();
    };

    /* ---------------- PRESS ANY BUTTON：线先到 → 逐字打出来 ----------------
     * 照原版的节奏：
     *   ① 线先从中间向两侧展开（300ms），两端圆点随后浮现
     *   ② 再开始逐字，65ms/字；每个字先闪现一个"错字"约 30ms 再改正
     *   ③ 打字期间两侧有横向拖影，打完仍会零星闪
     */
    const PRESS_POOL = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';

    const sleep2 = (ms: number) => new Promise<void>((r) => window.setTimeout(r, ms));

    const typePress = async () => {
      const txt = tp.querySelector<HTMLElement>('.tp-press .txt');
      const smear = tp.querySelector<HTMLElement>('.tp-press .smear');
      const streak = tp.querySelector<HTMLElement>('.tp-press .streak');
      if (!txt || !smear) return;

      const chars = [...(txt.dataset.type ?? 'Press Any Button')];

      // ① 线先到
      pressEl?.classList.add('is-line');
      await sleep2(300);

      // ② 逐字，前沿错字
      txt.textContent = '';
      smear.textContent = '';
      for (let i = 0; i < chars.length; i += 1) {
        const ghost = PRESS_POOL[Math.floor(Math.random() * PRESS_POOL.length)];
        txt.textContent = chars.slice(0, i).join('') + ghost;
        smear.textContent = txt.textContent;
        await sleep2(28);

        txt.textContent = chars.slice(0, i + 1).join('');
        smear.textContent = txt.textContent;
        await sleep2(37);
      }

      pressEl?.classList.add('done');

      // ③ 打字期间与之后，两侧零星拖影
      const bits = [...(streak?.querySelectorAll<HTMLElement>('i') ?? [])];
      const drawStreak = (alive: number) => {
        for (const b of bits) {
          if (Math.random() > alive) {
            b.style.opacity = '0';
            continue;
          }
          b.style.left = `${(Math.random() * 100).toFixed(1)}%`;
          b.style.width = `${(4 + Math.random() * 22).toFixed(1)}%`;
          b.style.top = `${(30 + Math.random() * 34).toFixed(0)}%`;
          b.style.opacity = String(0.12 + Math.random() * 0.4);
        }
      };
      for (let i = 0; i < 8; i += 1) {
        drawStreak(0.5);
        await sleep2(90);
      }
      const idle = window.setInterval(() => drawStreak(0.28), 140);
      window.setTimeout(() => {
        window.clearInterval(idle);
        for (const b of bits) b.style.opacity = '0';
      }, 5200);
    };

    const enterHome = () => {
      // 收尾兜底：序列可能正好卡在「黑场」中间被点了，这里必须把遮罩摘掉
      aborted = true;
      clearTimers();
      tp.classList.remove('is-blackout', 'is-flash');
      tp.setAttribute('data-state', 'home');
      tp.setAttribute('data-phase', '4');
      tp.classList.add('is-grown');
      startTitleMusic();
      root.classList.remove('is-booting');
      try {
        localStorage.setItem(KEY, '1');
      } catch {
        /* 隐私模式 */
      }
      audio.start();
    };

    // 只认标题帧那一次点击；前面几帧不许跳过
    const advance = () => {
      if (done || phase < 4) return;
      done = true;
      enterHome(); // 里面会 aborted = true + clearTimers + 摘遮罩
    };

    const params = new URLSearchParams(location.search);

    if (root.getAttribute('data-boot') === 'skip') {
      // 已经看过的访客：直接落在首页状态
      done = true;
      clearTimers();
      fillAll();
      tp.setAttribute('data-phase', '4');
      tp.setAttribute('data-state', 'home');
      tp.classList.add('is-grown');
      startTitleMusic();
      window.addEventListener('pointerdown', () => audio.start(), { once: true });
    } else if (params.get('state') === 'home') {
      // 调试：?state=home 直接看菜单状态
      fillAll();
      setPhase(4);
      tp.classList.add('is-grown');
      startTitleMusic();
      tp.setAttribute('data-state', 'home');
      const t = tp.querySelector<HTMLElement>('.tp-press .txt');
      if (t) t.textContent = t.dataset.type ?? '';
      pressEl?.classList.add('is-line', 'done');
    } else if (params.get('phase')) {
      // 调试：?phase=1/2/3/4 直接定格到某一帧，只给截图用
      const jump = Number(params.get('phase'));
      fillAll();
      if (jump === 2) {
        setPhase(2);
      } else if (jump === 3) {
        setPhase(3);
        if (faultEl) startFault(faultEl, FAULT_TEXT);
      } else if (jump === 4) {
        setPhase(4);
        tp.classList.add('is-grown');
        startTitleMusic();
        const txt = tp.querySelector<HTMLElement>('.tp-press .txt');
        const smear = tp.querySelector<HTMLElement>('.tp-press .smear');
        if (txt) txt.textContent = txt.dataset.type ?? '';
        if (smear) smear.textContent = txt?.dataset.type ?? '';
        pressEl?.classList.add('is-line', 'done');
      } else {
        setPhase(1);
        startWobble();
      }
    } else {
      root.classList.add('is-booting');
      setPhase(1);

      if (reduce) {
        fillAll();
        setPhase(4);
        tp.classList.add('is-grown');
        startTitleMusic();
        const txt = tp.querySelector<HTMLElement>('.tp-press .txt');
        if (txt) txt.textContent = txt.dataset.type ?? '';
        pressEl?.classList.add('is-line', 'done');
      } else {
        startWobble();
        void runSequence();
      }

      window.addEventListener('keydown', advance, { capture: true });
      window.addEventListener('pointerdown', advance, { capture: true });

      // 什么都不做也别把人困住
      window.setTimeout(() => {
        if (!done && phase < 4) {
          aborted = true;
          tp.classList.remove('is-blackout', 'is-flash');
          fillAll();
          setPhase(4);
          tp.classList.add('is-grown');
          startTitleMusic();
        }
      }, 20_000);
    }
  }
</script>
