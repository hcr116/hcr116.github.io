---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';

const menu = [
  { label: '简介', en: 'BRIEF', href: '/about/' },
  { label: '作品', en: 'WORKS', href: '/' },
  { label: '时间线', en: 'TIMELINE', href: '/timeline/' },
  { label: '联系', en: 'CONTACT', href: `mailto:${SITE.email}` },
];
---

<Base
  title={`${SITE.name} · 简易模式`}
  description={`${SITE.name} 的简易版主页`}
  bodyClass="mode-simple"
  mainClass="simple-main"
  hideNav
>
  <section class="simple-stage">
    <div class="simple-lead">
      <h1 class="simple-title">
        <span class="simple-title-en">HI I'M</span>
        <span class="simple-title-name">黄晨睿</span>
      </h1>

      <p class="simple-sub">
        <span class="simple-mark" aria-hidden="true"></span>
        一个动作游戏战斗策划
      </p>

      <nav class="simple-menu" aria-label="简易模式导航">
        {
          menu.map((item) => (
            <a href={item.href}>
              <span>{item.label}</span>
              <em>{item.en}</em>
            </a>
          ))
        }
      </nav>
    </div>

    <div class="simple-art" aria-hidden="true">
      <svg class="emblem" viewBox="0 0 400 400" role="presentation">
        <circle cx="200" cy="200" r="172" fill="none" stroke="#2b2b34" stroke-width="1.5" />
        <circle cx="200" cy="200" r="146" fill="none" stroke="#2b2b34" stroke-width="1" stroke-dasharray="2 9" />
        <g class="emblem-spin">
          <circle
            cx="200"
            cy="200"
            r="124"
            fill="none"
            stroke="currentColor"
            stroke-opacity="0.55"
            stroke-width="1.5"
            stroke-dasharray="30 14"
          />
          <circle cx="200" cy="76" r="5.5" fill="currentColor" />
          <circle cx="324" cy="200" r="3" fill="currentColor" fill-opacity="0.7" />
        </g>
        <circle cx="200" cy="200" r="76" fill="#1c1c23" stroke="#34343f" stroke-width="1.5" />
        <circle cx="200" cy="200" r="44" fill="none" stroke="currentColor" stroke-opacity="0.75" stroke-width="1.5" />
        <circle cx="200" cy="200" r="11" fill="currentColor" />
      </svg>
    </div>
  </section>

  <p class="simple-caption">这个页面刚开始搭，后面会往里塞点好玩的东西。</p>
</Base>
