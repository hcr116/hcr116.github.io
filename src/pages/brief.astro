---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import '../styles/profile.css';

// 先按「经历」硬编码；等你把简历导进来，再换成解析简历的数据源
const rows = [
  {
    year: '至今',
    en: 'NOW',
    title: '在动作游戏项目做怪物与 Boss',
    desc: '打击模组拆解、韧性体系搭建、对峙节奏调优；把「这只怪该怎么被读懂」写成可执行的规则。',
    tags: ['怪物', 'Boss', '韧性'],
  },
  {
    year: '2025',
    en: 'FEEL',
    title: '把打击感拆成分档参数',
    desc: '顿帧、震屏、卡肉、命中停——按冲击力分级给出参数表，并做成可直接对照的评审表。',
    tags: ['打击感', '帧数'],
  },
  {
    year: '2024',
    en: 'ARCHIVE',
    title: '12 款动作游戏逐招拆完',
    desc: '累计 18 章、6.7 万字，覆盖怪物、Boss、角色与通用方法论。',
    tags: ['拆解', '方法'],
  },
  {
    year: '2021',
    en: 'START',
    title: '从玩家到策划的起点',
    desc: '开始把玩过的动作游戏做成一页页拆解，先记清楚「这一刀为什么爽」。',
    tags: ['起点', '练习'],
  },
];
---

<Base
  title={`简介 · ${SITE.name}`}
  description={`${SITE.cnName}的个人简介`}
  bodyClass="mode-fun"
  mainClass="pf-main"
>
  <header class="pf-head">
    <div>
      <p class="pf-kicker">PROFILE</p>
      <h1 class="pf-name">{SITE.cnName}</h1>
    </div>
    <p class="pf-meta">
      动作游戏 · 战斗策划<br />
      怪物 / Boss / 打击反馈<br />
      在职 · 可聊
    </p>
  </header>

  <div class="pf-rows">
    {
      rows.map((r, i) => (
        <article class:list={['pf-row', i === 0 && 'is-now']}>
          <div class="pf-year">
            <b>{r.year}</b>
            <span>{r.en}</span>
          </div>
          <div class="pf-card">
            <h2>{r.title}</h2>
            <p>{r.desc}</p>
            <div class="pf-tags">
              {r.tags.map((t) => (
                <span>{t}</span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="pf-foot-links">
    <a class="primary" href="/articles/">看拆解 →</a>
    <a href="https://space.bilibili.com/4592990" target="_blank" rel="noopener">Bilibili</a>
    <a href="https://github.com/hcr116" target="_blank" rel="noopener">GitHub</a>
    <span>简历 PDF · 待补</span>
  </div>

  <div class="au-status" style="margin-top:28px">
    <span>PROFILE · 01 / 01</span>
    <span>等简历导入后重做这一页</span>
  </div>
</Base>
