---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { SITE } from '../../../consts';
import '../../../styles/ai-doc.css';

export async function getStaticPaths() {
  // locked 的条目不生成详情页（它只有乱码 + 权限不足）
  const all = (await getCollection('ai', ({ data }) => !data.draft && !data.locked)).sort(
    (a, b) => b.data.order - a.data.order || b.data.year.localeCompare(a.data.year),
  );

  return all.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: all[index - 1] ?? null,
      next: all[index + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

// 右侧目录只收 h2（正文按「介绍 / 设计目的 / 怎么做的 / 踩了什么坑」四节写）
const toc = headings.filter((h) => h.depth === 2);
const meta = [data.year, data.state].filter(Boolean);
---

<Base
  title={`${data.title} · ${SITE.name}`}
  description={data.summary}
  bodyClass="mode-fun"
  mainClass="ai-main"
  hideNav
  crumbLast={data.title}
>
  <article class="ai-doc">
    <div class="ai-col">
      <header class="ai-head">
        {data.en && <p class="ai-eyebrow">{data.en}</p>}
        <h1>{data.title}</h1>
        <p class="ai-summary">{data.summary}</p>

        <ul class="ai-meta">
          {meta.map((m) => <li>{m}</li>)}
          {data.stack.map((s) => <li class="tech">{s}</li>)}
        </ul>
      </header>

      {
        data.private && (
          <p class="ai-note">
            <b>仅展示</b>
            这套东西是自用的，不提供源码、也不开放试用；下面只有截图和做法说明。
          </p>
        )
      }

      {
        data.video && (
          <figure class="ai-video">
            <div class="frame">
              <iframe
                src={data.video}
                title={`${data.title} 演示`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
            <figcaption>演示：{data.title}</figcaption>
          </figure>
        )
      }

      <div class="ai-body">
        <Content />
      </div>

      {
        data.shots.length > 0 && (
          <section class="ai-shots">
            <h2>截图</h2>
            <div class="grid">
              {data.shots.map((shot) => (
                <figure class:list={['ai-shot', shot.blur && 'is-masked']} data-shot>
                  <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" />
                  {shot.blur && (
                    <button class="mask" type="button" data-unmask>
                      <span class="dot" aria-hidden="true" />
                      点一下查看（含隐私信息）
                    </button>
                  )}
                  {shot.alt && <figcaption>{shot.alt}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <nav class="ai-pager">
        {prev ? <a href={`/works/ai/${prev.id}/`}>← {prev.data.title}</a> : <span />}
        {next && <a class="next" href={`/works/ai/${next.id}/`}>{next.data.title} →</a>}
      </nav>
    </div>

    {
      toc.length > 1 && (
        <aside class="ai-toc">
          <div class="k">目录</div>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
  </article>
</Base>

<script>
  /* 隐私截图：默认盖住，点一下才显示。只认「这一张」，不记忆。 */
  for (const shot of document.querySelectorAll<HTMLElement>('.ai-shot[data-shot]')) {
    const btn = shot.querySelector<HTMLButtonElement>('[data-unmask]');
    if (!btn) continue;
    btn.addEventListener('click', () => {
      shot.classList.remove('is-masked');
    });
  }
</script>
