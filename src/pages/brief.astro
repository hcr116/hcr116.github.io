---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { t as ct } from '../data/copy';
import '../styles/profile.css';

/* 简介页：先自述，再工作经历（经历等简历导入后自动生成，现在留空） */

// 自述：先写草稿，之后你自己改
const about = [
  ct('brief.intro.1', '做动作游戏的战斗策划，主要管怪物与 Boss：把「这一刀为什么爽」拆成可执行的规则，再把这些规则变成能调、能评审的参数表。'),
  ct('brief.intro.2', '日常是三件事：拆解已有的动作游戏（18 章、6.7 万字）、把打击反馈拆成分档参数、以及在项目里把怪物的行为逻辑写成别人也能读懂的设计文档。'),
  ct('brief.intro.3', '业余在折腾 AI 小工具 —— 本站、面试记录归档、背诵卡片都是自己写自己用的。不算产品，但都在跑。'),
];

// 工作经历：等简历导进来再填。格式先定死，导入脚本照着这个顺序灌。
const jobs: { range: string; company: string; role: string; note: string }[] = [];
---

<Base
  title={`简介 · ${SITE.name}`}
  description={`${SITE.cnName}的个人简介`}
  bodyClass="mode-fun"
  mainClass="pf-main"
>
  <header class="pf-head">
    <div>
      <p class="pf-kicker">PROFILE</p>
      <h1 class="pf-name">{SITE.cnName}</h1>
    </div>
    <p class="pf-meta">
      {ct('brief.tagline.1', '动作游戏 · 战斗策划')}<br />
      {ct('brief.tagline.2', '怪物 / Boss / 打击反馈')}<br />
      {ct('brief.tagline.3', '在职 · 可聊')}
    </p>
  </header>

  <section class="pf-sec">
    <h2 class="pf-sec-k">{ct('brief.sec.about', '自述')}</h2>
    <div class="pf-prose">
      {about.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="pf-sec">
    <h2 class="pf-sec-k">{ct('brief.sec.work', '工作经历')}</h2>

    {
      jobs.length > 0 ? (
        <div class="pf-rows">
          {jobs.map((j) => (
            <article class="pf-row">
              <div class="pf-year">
                <b>{j.range}</b>
                <span>{j.role}</span>
              </div>
              <div class="pf-card">
                <h3>{j.company}</h3>
                <p>{j.note}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="pf-empty">
          <span class="dot" aria-hidden="true" />
          {ct('brief.work.empty', '还没有内容 —— 简历导入后按「年份区间 · 公司 · 职位 · 一句话」自动排进来。')}
        </p>
      )
    }
  </section>

  <div class="pf-foot-links">
    <a class="primary" href="/articles/">{ct('brief.cta', '看拆解 →')}</a>
    <a href="https://space.bilibili.com/4592990" target="_blank" rel="noopener">Bilibili</a>
    <a href="https://github.com/hcr116" target="_blank" rel="noopener">GitHub</a>
    <span>{ct('brief.pdf', '简历 PDF · 待补')}</span>
  </div>
</Base>
