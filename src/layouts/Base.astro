---
import { getEntry } from 'astro:content';
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 加到 <body> 上的额外 class，用来切换整站配色（如简易模式） */
  bodyClass?: string;
  /** 覆盖 <main> 的 class，默认是 wrap（限宽居中） */
  mainClass?: string;
  /** 为 true 时不显示右上角导航 */
  hideNav?: boolean;
}

const {
  title = SITE.title,
  description = SITE.intro,
  bodyClass = '',
  mainClass = 'wrap',
  hideNav = false,
} = Astro.props;
const path = Astro.url.pathname;
const year = new Date().getFullYear();

// 当前是否在「简易」模式（/simple 开头的路由）
const isSimple = path.startsWith('/simple');
const toggleHref = isSimple ? '/' : '/simple/';
const toggleLabel = isSimple ? '有趣' : '简易';

// 背景音乐设置来自 src/content/settings/settings.md
const settings = await getEntry('settings', 'settings');
const bgmSrc = settings?.data.bgm?.trim() ?? '';
const bgmVolume = Math.min(100, Math.max(0, settings?.data.bgmVolume ?? 35)) / 100;

const navItems = [
  { label: '作品', href: '/' },
  { label: '关于', href: '/about/' },
  { label: '时间线', href: '/timeline/' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121213" media="(prefers-color-scheme: dark)" />
  </head>

  <body class={bodyClass}>
    <header class="site-header">
      <div class="wrap header-inner">
        <a
          class="mode-toggle"
          href={toggleHref}
          aria-label={isSimple ? '返回常规首页' : '切换到简易模式'}
        >
          {toggleLabel}
        </a>
        <nav class="nav" aria-label="主导航">
          {
            !hideNav &&
              navItems.map((item) => (
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
          }
          {
            bgmSrc && (
              <button
                type="button"
                class="sound-toggle"
                id="sound-toggle"
                data-on="false"
                data-src={bgmSrc}
                data-volume={bgmVolume}
                aria-pressed="false"
                aria-label="播放背景音乐"
                title="播放背景音乐"
              >
                <svg data-icon="off" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
                  <path d="M16.5 8.5l5 5m0-5l-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
                </svg>
                <svg data-icon="on" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
                  <path d="M16.5 8.2a5 5 0 0 1 0 7.6M19 5.8a8.5 8.5 0 0 1 0 12.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
                </svg>
              </button>
            )
          }
        </nav>
      </div>
    </header>

    <main class={mainClass}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>© {year} {SITE.name}{SITE.location ? ` · ${SITE.location}` : ''}</p>
        <div class="footer-links">
          {SITE.links.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={`mailto:${SITE.email}`}>邮件</a>
        </div>
      </div>
    </footer>

    <script>
      // 背景音乐开关：浏览器禁止带声音的自动播放，
      // 所以默认静音，用户点一下才播；选择记在 localStorage 里，翻页后保持。
      const btn = document.getElementById('sound-toggle');
      if (btn) {
        const audio = new Audio();
        audio.src = btn.dataset.src || '';
        audio.loop = true;
        audio.preload = 'none';
        audio.volume = Number(btn.dataset.volume || 0.35);

        const KEY = 'bgm-on';
        const setUI = (on) => {
          btn.dataset.on = String(on);
          btn.setAttribute('aria-pressed', String(on));
          const label = on ? '关闭背景音乐' : '播放背景音乐';
          btn.setAttribute('aria-label', label);
          btn.title = label;
        };

        setUI(false);

        const play = async () => {
          try {
            await audio.play();
            setUI(true);
            localStorage.setItem(KEY, '1');
          } catch {
            // 被浏览器拦下（多半是还没交互过），保持关闭状态
            setUI(false);
          }
        };

        const pause = () => {
          audio.pause();
          setUI(false);
          localStorage.setItem(KEY, '0');
        };

        btn.addEventListener('click', () => {
          if (audio.paused) play();
          else pause();
        });

        // 上次开着的话，这次尽量接着放；被拦下就静音等着用户点
        if (localStorage.getItem(KEY) === '1') play();
      }
    </script>
  </body>
</html>
