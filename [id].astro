---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.order - a.data.order || b.data.year.localeCompare(a.data.year),
  );

  return works.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: works[index - 1] ?? null,
      next: works[index + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const meta = [data.year, data.role].filter(Boolean).join(' · ');
---

<Base title={`${data.title} · ${SITE.name}`} description={data.summary}>
  <a class="back" href="/">← 全部作品</a>

  <header class="work-header">
    <p class="eyebrow">{meta}</p>
    <h1>{data.title}</h1>
    <p class="work-lead">{data.summary}</p>
    {
      data.tags.length > 0 && (
        <ul class="tag-list">
          {data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </header>

  {
    data.cover && (
      <figure class="work-hero">
        <img src={data.cover} alt={data.coverAlt || data.title} decoding="async" />
      </figure>
    )
  }

  {
    data.video && (
      <div class="video-embed">
        <iframe
          src={data.video}
          title={`${data.title} 演示视频`}
          loading="lazy"
          allowfullscreen
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          referrerpolicy="no-referrer"
        />
      </div>
    )
  }

  <article class="prose">
    <Content />
  </article>

  {
    data.docs.length > 0 && (
      <section class="doc-section">
        <h2>说明文档</h2>
        <div class="doc-list">
          {data.docs.map((doc) => (
            <a class="doc-link" href={doc.href} target="_blank" rel="noopener">
              <span class="doc-kind">PDF</span>
              <span>{doc.label}</span>
              <span class="doc-arrow" aria-hidden="true">
                ↘
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <nav class="work-nav" aria-label="作品导航">
    {
      prev ? (
        <a href={`/works/${prev.id}/`}>
          <span class="nav-label">上一个</span>
          {prev.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="nav-next" href={`/works/${next.id}/`}>
          <span class="nav-label">下一个</span>
          {next.data.title}
        </a>
      )
    }
  </nav>
</Base>
