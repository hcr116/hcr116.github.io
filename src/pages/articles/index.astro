---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import { t as ct, tf } from '../../data/copy';
import { SITE } from '../../consts';
import '../../styles/ar-ps.css';
import '../../styles/crt.css';
/* 存档层（就地展开）的样式在 works-ps.css 里，和作品页共用一套 */
import '../../styles/works-ps.css';

// 从三块正文里抽出章节标题和那行斜体元信息，列表就不用再手写一遍
type Card = { title: string; meta: string; text: string; group: string; href: string };

const SRC = [
  { key: 'monster', label: ct('articles.folder.monster', '怪物'), file: 'monster.md' },
  { key: 'character', label: ct('articles.folder.character', '角色'), file: 'character.md' },
  { key: 'method', label: ct('articles.folder.method', '方法'), file: 'method.md' },
];

const cards: Card[] = [];

for (const src of SRC) {
  // 构建时 frontmatter 在 dist 里跑，用 cwd 定位源文件才靠谱
  const path = join(process.cwd(), 'src/articles/combat', src.file);
  const md = readFileSync(path, 'utf8');
  const lines = md.split(/\r?\n/);

  let current: { title: string; meta: string; paras: string[] } | null = null;

  const flush = () => {
    if (!current) return;
    const title = current.title.replace(/^\d+\s*/, '');
    const text =
      current.paras.find(
        (t) => t.length >= 14 && !t.endsWith('：') && !/^\d{4}\s*年/.test(t),
      ) ?? current.paras[0] ?? '';
    cards.push({
      title,
      meta: current.meta,
      text: text.replace(/<[^>]+>/g, '').slice(0, 60),
      group: src.label,
      href: `/articles/combat/?tab=${src.key}`,
    });
    current = null;
  };

  for (const line of lines) {
    if (line.startsWith('## ')) {
      flush();
      current = { title: line.slice(3).trim(), meta: '', paras: [] };
      continue;
    }
    if (!current) continue;
    const t = line.trim();
    if (!current.meta && /^\*[^*].*\*$/.test(t)) {
      current.meta = t.replace(/^\*|\*$/g, '').trim();
      continue;
    }
    if (
      t &&
      !t.startsWith('#') &&
      !t.startsWith('|') &&
      !t.startsWith('![') &&
      !t.startsWith('<') &&
      current.paras.length < 4
    ) {
      current.paras.push(t);
    }
  }
  flush();
}

// 外层三个文件夹：怪物 / 角色 / 其他（"方法"归到其他里）
const groups = [
  {
    key: 'monster',
    cn: ct('articles.set.monster.name', '怪物'),
    en: ct('articles.set.monster.en', 'MONSTERS'),
    tone: '#3c3c45',
    note: ct('articles.set.monster.note', '把战斗拆成可复用的判断：通用框架、Boss 拆解、韧性规则。'),
    items: cards.filter((c) => c.group === '怪物'),
  },
  {
    key: 'character',
    cn: ct('articles.set.character.name', '角色'),
    en: ct('articles.set.character.en', 'CHARACTERS'),
    tone: '#565660',
    note: ct('articles.set.character.note', '角色怎么被设计出来：定位、资源流转、循环结构、额外身份。'),
    items: cards.filter((c) => c.group === '角色'),
  },
  {
    key: 'other',
    cn: ct('articles.set.other.name', '其他'),
    en: ct('articles.set.other.en', 'OTHERS'),
    tone: '#2b2b33',
    note: ct('articles.set.other.note', '方法类的四篇：帧数表、学习路径、工作复盘这些。'),
    items: cards.filter((c) => c.group === '方法'),
  },
];

const total = cards.length;
const plan = (i: number) => String(i + 1).padStart(2, '0');

/* 存档层的数据：一个文件夹 = 一个频道，每篇文章 = 一张卡（点开跳 ?tab=） */
const archiveChannels = Object.fromEntries(
  groups.map((g) => [
    g.key,
    {
      id: g.key,
      title: g.cn,
      items: g.items.map((c, i) => ({
        id: `${g.key}-${i}`,
        kind: 'link' as const,
        title: c.title,
        sub: c.meta,
        tag: plan(i),
        href: c.href,
      })),
    },
  ]),
);

const archiveData = JSON.stringify(archiveChannels);
---

<Base
  title={`文章 · ${SITE.name}`}
  description={`${SITE.cnName}的文章：战斗策划经验、游戏体验记录、素材库`}
  bodyClass="mode-fun"
  mainClass="ar-main"
  hideNav
>
  <div class="ar-bg"></div>
  <div class="ar-wash" data-wash></div>
  <div class="ar-glow" data-glow></div>

  <div class="ar-shell">
    <header class="ar-top">
      <button class="ar-back" type="button" data-back hidden>← {ct('articles.back', '返回文件夹')}</button>
      <div class="ar-clock">
        <span class="dot" aria-hidden="true"></span>
        <time data-clock>00:00</time>
      </div>
    </header>

    {/* 返回用的背板：点它 = 返回（比内容低一层，不会挡住卡片） */}
    <button class="ws-vfx-backdrop" type="button" data-backdrop aria-label="返回" tabindex="-1"></button>

    <div class="ar-rail">
      <!-- 三个文件夹 = 三个频道 -->
      <div class="ar-track" data-track>
        {
          groups.map((g, i) => (
            <a
              class:list={['ar-tile', 'is-folder', 'crt-tile', i === 0 && 'is-on']}
              href={`#${g.key}`}
              data-tile
              data-folder={g.key}
              data-sfx-off
              data-tone={g.tone}
              data-cn={g.cn}
              data-en={g.en}
              data-note={g.note}
              style={`--tone:${g.tone}`}
            >
              <span class="crt-art" aria-hidden="true" />
              <span class="crt-noise" aria-hidden="true" />
              <span class="crt-scan" aria-hidden="true" />
              <span class="crt-roll" aria-hidden="true" />
              <span class="crt-flash" aria-hidden="true" />
              <span class="ar-num crt-osd">{plan(i)}</span>
              <span class="ar-name">{g.cn} · {g.items.length}</span>
              <span class="ar-inline">{g.cn}</span>
            </a>
          ))
        }
      </div>
    </div>

    {/* 存档层：点文件夹就地展开文章网格（和作品页同一套） */}
    <section class="ws-vfx" data-vfx aria-label={ct('articles.title', '文章')}>
      <div class="ws-vfx-bg" data-vfx-bg aria-hidden="true"></div>
      <div class="ws-vfx-bg is-b" data-vfx-bg2 aria-hidden="true"></div>

      <div class="ws-vfx-wrap" data-vfx-wrap>
        <div class="ws-vfx-track" data-vfx-track>
          <span class="ws-vfx-focus" data-vfx-focus aria-hidden="true"></span>
        </div>

        <button class="ws-vfx-zone is-prev" type="button" data-zone="prev" aria-label="上一组"></button>
        <button class="ws-vfx-zone is-next" type="button" data-zone="next" aria-label="下一组"></button>
        <div class="ws-vfx-pager" data-pager aria-hidden="true"><b>01</b> / 02</div>
      </div>
    </section>

    <script type="application/json" data-archive-channels set:html={archiveData} />

    {/* 底部只留「○ 返回」（存档态才出现） */}
    <div class="ws-bar">
      <button class="ws-vfx-legend" type="button" data-vfx-close aria-label="返回" hidden><i aria-hidden="true">○</i> {ct('ui.back', '返回')}</button>
    </div>
    <!--
      标题区：跟着选中项走（和作品页一致）。
      方框右侧还会再出现一次名字（PS4 的排法），那是"当前频道"的标识。
    -->
    <div class="ar-head" data-head>
      <h1 data-h1>{ct('articles.title', '文章')}</h1>
      <div class="en" data-en>{tf('articles.en', { n: total }, 'ARTICLES · 3 组 · {n} 篇')}</div>
      <p data-note>{ct('articles.note', '按分类收着的写作档案：怪物 / 角色 / 其他。')}</p>
    </div>

    <div class="ar-actions">
      <a class="ar-play" href="#" data-play>▶ {ct('articles.open', '打开')}</a>
      <button class="ar-more" type="button" aria-label={ct('ui.more', '更多')}>•••</button>
    </div>

  </div>
</Base>

<script>
  import { attachCrt } from '../../scripts/crt-tv';
  import { t as ct, tf } from '../../data/copy';
  import { initRail } from '../../scripts/rail';
  import { initArchive } from '../../scripts/archive';

  const main = document.querySelector('.ar-main');
  const clock = document.querySelector<HTMLElement>('[data-clock]');

  /* 从作品页点「战策经验」进来时，面包屑前面补一段「作品」，让人点得回去。
     静态站构建期没有 query，所以只能在浏览器里补。 */
  const FROM_PARENTS: Record<string, string> = { combat: '/works/', ai: '/works/' };
  const from = new URLSearchParams(location.search).get('from');
  if (from && FROM_PARENTS[from]) {
    const here = document.querySelector('.crumbs .here');
    if (here) {
      here.insertAdjacentHTML(
        'beforebegin',
        '<a href="' + FROM_PARENTS[from] + '">作品</a><span class="sep" aria-hidden="true">/</span>',
      );
    }
  }

  /* 频道 = 文件夹。点它就地展开该文件夹的文章（和作品页同一套存档层） */
  const channels = JSON.parse(
    document.querySelector<HTMLScriptElement>('[data-archive-channels]')?.textContent ?? '{}',
  );

  const tileOf = (tile: HTMLElement): string | null => {
    const href = tile.getAttribute('href') ?? '';
    if (!href.startsWith('#')) return null;
    return channels[href.slice(1)] ? href.slice(1) : null;
  };

  /* 先把频道条接上，存档层的 onToggle 要用到它 */
  const rail = initRail({
    track: '.ar-track',
    tile: '.ar-tile',
    initial: 0,
  });

  const archive = initArchive({
    root: main as HTMLElement | null,
    grid: document.querySelector<HTMLElement>('[data-vfx-track]'),
    pageSize: 4,
    pager: document.querySelector<HTMLElement>('[data-pager]'),
    focus: document.querySelector<HTMLElement>('[data-vfx-focus]'),
    bgLayers: [
      document.querySelector<HTMLElement>('[data-vfx-bg]'),
      document.querySelector<HTMLElement>('[data-vfx-bg2]'),
    ].filter(Boolean) as HTMLElement[],
    legend: document.querySelector<HTMLElement>('.ws-vfx-legend'),
    crumbs: (() => {
      const host = document.querySelector<HTMLElement>('.crumbs');
      if (!host) return null;
      return {
        host,
        html: (channel) =>
          '<span class="sep" aria-hidden="true">/</span><span class="here">' +
          (channel.title ?? '') +
          '</span>',
      };
    })(),
    channels,
    urlParam: 'ch',
    emptyText: ct('articles.empty', '还没有文章'),
    onToggle: (_open, channel) => {
      const tiles = rail.tiles;
      const i = tiles.findIndex((tile) => tileOf(tile) === channel.id);
      if (i >= 0) rail.select(i, true);
    },
  });

  for (const tile of rail.tiles) {
    const id = tileOf(tile);
    if (id) tile.setAttribute('data-no-xfer', '');
    tile.addEventListener('click', (event) => {
      if (!id) return;
      event.preventDefault();
      archive.open(id);
    });
  }

  /* 老电视：悬停 = 临时开机 / 划走 = CRT 关机 */
  attachCrt();

  const tick = () => {
    if (!clock) return;
    const now = new Date();
    clock.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
  };
  tick();
  window.setInterval(tick, 30_000);
</script>
