---
import Base from '../../layouts/Base.astro';
import { SITE, ABYSS_GAME } from '../../consts';
// 阿比斯专用的样式只在这两个页面加载，站点那边一条都没有
import '../../styles/abyss.css';

// 背景里飘的那点东西（纯装饰，不进玩法）
const motes = [
  { x: 14, y: 22, s: 2, o: 0.5 },
  { x: 78, y: 16, s: 3, o: 0.35 },
  { x: 32, y: 64, s: 2, o: 0.45 },
  { x: 88, y: 58, s: 4, o: 0.22 },
  { x: 22, y: 84, s: 3, o: 0.3 },
  { x: 62, y: 34, s: 2, o: 0.55 },
  { x: 46, y: 12, s: 2, o: 0.28 },
  { x: 8, y: 46, s: 4, o: 0.18 },
  { x: 92, y: 78, s: 2, o: 0.4 },
  { x: 54, y: 88, s: 3, o: 0.24 },
  { x: 70, y: 70, s: 2, o: 0.32 },
  { x: 38, y: 44, s: 3, o: 0.2 },
];
---

<Base
  title={`阿比斯 · 深渊 · ${SITE.name}`}
  description="往下，再往下"
  bodyClass="mode-fun mode-abyss"
  mainClass="dive-main"
>
  {/*
    这是那个网页小游戏。ABYSS_GAME = false 时整块不渲染。
    游戏脚本都会先检查 DOM 在不在，DOM 没了就直接退出。
  */}
  {ABYSS_GAME && (
    <section class="dive" data-dive-track style="--dive-screens:0">
      <div class="dive-stage" data-dive-stage>
        <div class="dive-scene" aria-hidden="true">
          <div class="dive-layer dive-layer--glow" data-speed="0.05"></div>

          <div class="dive-layer" data-speed="0.16">
            <span class="dive-ring" style="--r: 21rem"></span>
            <span class="dive-ring" style="--r: 33rem"></span>
            <span class="dive-ring" style="--r: 45rem"></span>
          </div>

          <div class="dive-layer" data-speed="0.5">
            {motes.map((m) => (
              <span class="dive-mote" style={`--x:${m.x}%;--y:${m.y}%;--s:${m.s}px;--o:${m.o}`} />
            ))}
          </div>

          <div class="dive-layer dive-layer--grain" data-speed="0.92"></div>
        </div>

        {/* 地图、HUD、背包、面板都由脚本挂在这上面 */}
        <div class="dive-map" data-abyss-map-host></div>
      </div>
    </section>
  )}

  {!ABYSS_GAME && (
    <section class="dive-offline">
      <p class="dive-offline-eyebrow">ABYSS · 信号中断</p>
      <h1 class="dive-offline-title">这一段暂时没有信号</h1>
      <p class="dive-offline-note">深处的记录还在，只是现在收不到。</p>
      <div class="dive-end-links">
        <a href="/abyss/">回入口</a>
        <a href="/">回首页</a>
      </div>
    </section>
  )}

  <script>
    // 世界：节点地图（杀戮尖塔那张图）
    import '../../scripts/abyss/map';
    // 面板与物件
    import '../../scripts/abyss/hud';
    import '../../scripts/abyss/bag';
    import '../../scripts/abyss/inspect';
    import '../../scripts/abyss/fight';
  </script>
</Base>
