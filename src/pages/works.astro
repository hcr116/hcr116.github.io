---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { counts } from '../data/counts';
import { vfxItems } from '../data/vfx';
import { t, tf } from '../data/copy';
import '../styles/works-ps.css';
import '../styles/crt.css';

/* 五个方向。
 * href 有值 = 点方块/打开就真的进那个分区；没有就只有锚点（还没内容）。
 * note 里那句「已导入 N 个」的 N 是数出来的，见 src/data/counts.ts。 */
const n = counts();

const items = [
  {
    id: 'game-demo',
    title: t('works.tile.game-demo.name', '游戏 DEMO'),
    cn: t('works.tile.game-demo.name', '游戏 DEMO'),
    en: t('works.tile.game-demo.en', '游戏 DEMO'),
    tone: '#b3492f',
    note: t('works.tile.game-demo.note', '用 UE5 做的切片和玩法原型'),
    state: '整理中',
    /* 还没内容，但点它就地展开一个空网格 */
    href: '#game-demo',
  },
  {
    id: 'combat',
    cn: t('works.tile.combat.name', '战斗拆解'),
    en: t('works.tile.combat.en', '战斗拆解'),
    tone: '#a8762c',
    note: t('works.tile.combat.note', '战斗系统拆解、数值、手感相关的笔记'),
    state: '已有内容',
    /* 战策经验跳文章页：和「AI 功能」一样走站内转场，不就地展开 */
    href: '/articles/?from=combat',
  },
  {
    id: 'ai',
    cn: t('works.tile.ai.name', 'AI 功能'),
    en: t('works.tile.ai.en', 'AI 功能'),
    tone: '#2f6f7d',
    note: t('works.tile.ai.note', '由自己提需求、agent 完成编码制作的功能模块'),
    state: '已有内容',
    /* 和特效一样：不跳页面，就地展开 */
    href: '#ai',
  },
  {
    id: 'bass',
    cn: t('works.tile.bass.name', '贝斯弹奏'),
    en: t('works.tile.bass.en', '贝斯弹奏'),
    tone: '#6a4a86',
    note: t('works.tile.bass.note', '业余弹的东西，纯爱好，不保证好听'),
    state: '整理中',
    href: '#bass',
  },
  {
    id: 'vfx',
    cn: t('works.tile.vfx.name', '特效作品'),
    en: t('works.tile.vfx.en', '特效作品'),
    tone: '#3f5a75',
    note: t('works.tile.vfx.note', '特效和动效的尝试'),
    state: '已有内容',
    /* 不再跳独立页面：点它就在本页展开存档（见下面的 .ws-vfx） */
    href: '#vfx',
  },
];

/* 导入状态：有内容的写「已导入 N 个」；还是空的写「待导入」并渲染成红字。
 * 两套文本都生成 —— data-note 是纯文本（无障碍 / 降级用），
 * data-note-html 带 <em>，给 hero 那块上色用。 */
const list = items.map((it) => {
  const count = n[it.id] ?? 0;
  const done = tf('ui.imported', { n: count }, '已导入 {n} 个');
  const pending = t('ui.more.pending', '待导入');
  const suffix = count > 0 ? `，${done}。` : `，${pending}。`;
  const suffixHtml = count > 0 ? `，${done}。` : `，<em class="ws-pending">${pending}</em>。`;
  return { ...it, note: it.note + suffix, noteHtml: it.note + suffixHtml };
});

const ready = list.filter((i) => i.state === '已有内容').length;

/* 存档层的数据：每个"就地展开"的频道一份。
   卡片不再写死在模板里，由 archive.ts 按这份数据渲染。 */
/* AI 功能：同样就地展开。只列能打开的，锁定条目不露标题。 */
const aiItems = (await getCollection('ai', ({ data }) => !data.draft && !data.locked))
  .sort(
    (a, b) => b.data.order - a.data.order || b.data.year.localeCompare(a.data.year),
  )
  .map((it, i) => ({
    id: it.id,
    kind: 'link' as const,
    title: it.data.title,
    sub: [it.data.en, it.data.year].filter(Boolean).join(' · '),
    tag: String(i + 1).padStart(2, '0'),
    href: `/works/ai/${it.id}/`,
  }));

const vfxCards = vfxItems.map((v) => ({
  id: v.id,
  kind: 'video' as const,
  title: v.label,
  sub: v.date,
  tag: `VFX ${v.id}`,
  dur: v.dur,
  poster: v.poster,
  src: v.src,
}));

const archiveChannels = {
  vfx: { id: 'vfx', title: t('works.tile.vfx.name', '特效作品'), items: vfxCards },
  'game-demo': {
    id: 'game-demo',
    title: t('works.tile.game-demo.name', '游戏 DEMO'),
    items: [] as typeof vfxCards,
  },
  ai: { id: 'ai', title: t('works.tile.ai.name', 'AI 功能'), items: aiItems },
  bass: { id: 'bass', title: t('works.tile.bass.name', '贝斯弹奏'), items: [] as typeof vfxCards },
};

const archiveData = JSON.stringify(archiveChannels);
---

<Base
  title={`作品 · ${SITE.name}`}
  description={`${SITE.cnName}的作品：游戏 demo、战斗策划经验、AI 功能、贝斯、特效`}
  bodyClass="mode-fun"
  mainClass="ws-main"
  hideNav
>
  <div class="ws-bg"></div>
  <div class="ws-glow" data-glow></div>

  <div class="ws-shell">
    <header class="ws-top">
      <div class="ws-clock">
        <span class="dot" aria-hidden="true"></span>
        <time data-clock>00:00</time>
      </div>
    </header>

    <div class="ws-rail" data-rail>
      <div class="ws-track" data-track>
        {
          list.map((it, i) => (
            <a
              class:list={['ws-tile', 'crt-tile', i === 0 && 'is-on']}
              href={it.href ?? `#${it.id}`}
              data-tile
              data-sfx-off
              data-tone={it.tone}
              data-cn={it.cn}
              data-en={it.en}
              data-note={it.note}
              data-note-html={it.noteHtml}
              data-count={n[it.id] ?? 0}
              data-ready={it.state === '已有内容' ? '1' : '0'}
              style={`--tone:${it.tone}`}
            >
              <span class="crt-art" aria-hidden="true" />
              <span class="crt-noise" aria-hidden="true" />
              <span class="crt-scan" aria-hidden="true" />
              <span class="crt-roll" aria-hidden="true" />
              <span class="crt-flash" aria-hidden="true" />
              <span class="ws-num crt-osd">{String(i + 1).padStart(2, '0')}</span>
              <span class="ws-tag-name">{it.cn}</span>
              <span class="ws-inline">{it.cn}</span>
              {/* 存档态下只有选中那颗挂名字（PS4 的做法） */}
              <span class="ws-ch-name">{it.cn}</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="ws-hero" data-hero>
      <h1 data-hero-title>{list[0].cn}</h1>
      <div class="en" data-hero-en>{list[0].en}</div>
      <p data-hero-note set:html={list[0].noteHtml}></p>
      <div class="ws-actions">
        <a class="ws-play" href={list[0].href ?? `#${list[0].id}`} data-hero-go>▶ {t('ui.open', '打开')}</a>
        <button class="ws-more" type="button" aria-label={t('ui.more', '更多')}>•••</button>
      </div>
    </div>

    <aside class="ws-card">
      <div class="k">{t('works.stat.title', '整理进度')}</div>
      <div class="row"><b data-stat>{ready} / {list.length}</b><span>{t('works.stat.unit', '已整理方向')}</span></div>
    </aside>

    {/* ============================================================
        同页展开：特效作品存档（XMB 结构）
        ------------------------------------------------------------
        点「特效作品」方块 → 不跳路由，给 .ws-main 加 .is-vfx：
        上面那排方块压成一条"频道条"，下面开出一条横向内容轨道。
        顶部「返回 / 面包屑」一直在，因为压根没离开这一页。
        ============================================================ */}
    {/* 返回用的背板：铺满整屏，点它 = 返回（它比内容低一层，所以不会挡住卡片） */}
    <button class="ws-vfx-backdrop" type="button" data-backdrop aria-label="返回" tabindex="-1"></button>

    <section class="ws-vfx" data-vfx aria-label={t('works.archive.title', '特效作品存档')}>
      {/* 背景：跟着当前选中的视频走（PS4 那种"画面铺底"） */}
      <div class="ws-vfx-bg" data-vfx-bg aria-hidden="true"></div>
      <div class="ws-vfx-bg is-b" data-vfx-bg2 aria-hidden="true"></div>

      <div class="ws-vfx-wrap" data-vfx-wrap>
        <div class="ws-vfx-track" data-vfx-track>
          {/* 焦点框：选中哪张就滑到哪张，PS4 的选中框就是会移动的 */}
          <span class="ws-vfx-focus" data-vfx-focus aria-hidden="true"></span>
          {/* 卡片由 archive.ts 按频道数据渲染（一套网格服务所有频道） */}
        </div>

        {/* 左右两边各一条热区：鼠标贴到边上就翻上一组 / 下一组。
            没有下一组时自动失效（pointer-events: none）。 */}
        <button class="ws-vfx-zone is-prev" type="button" data-zone="prev" aria-label="上一组"></button>
        <button class="ws-vfx-zone is-next" type="button" data-zone="next" aria-label="下一组"></button>
        <div class="ws-vfx-pager" data-pager aria-hidden="true"><b>01</b> / 02</div>
      </div>
    </section>

    {/* 存档频道的数据（JSON，客户端读它渲染卡片） */}
    <script type="application/json" data-archive-channels set:html={archiveData} />

    {/* 全屏播放：点当前那张卡打开。不放任何按钮 —— 点周围空白 / ESC 关闭 */}
    <div class="ws-vfx-player" data-player hidden>
      <video data-player-video controls playsinline></video>
    </div>

    {/* 底部只留「○ 返回」（存档态才出现）。操作提示和 HCR · WORKS 都撤了 */}
    <div class="ws-bar">
      <button class="ws-vfx-legend" type="button" data-vfx-close aria-label={t('ui.back.label', '回到五个方向')} hidden><i aria-hidden="true">○</i> {t('ui.back', '返回')}</button>
    </div>
  </div>
</Base>

<script>
  import { attachCrt, powerOn, powerOff } from '../scripts/crt-tv';
  import { initArchive } from '../scripts/archive';
  import { dissolveTile, removeAndShift } from '../scripts/dissolve';
  import { worldlineSwap } from '../scripts/worldline';
  import { t } from '../data/copy';

  const rail = document.querySelector('[data-rail]');
  const track = document.querySelector('[data-track]');
  const glow = document.querySelector('[data-glow]');
  const shell = document.querySelector('.ws-main');
  const hero = document.querySelector('[data-hero]');
  const tiles = track ? [...track.querySelectorAll('[data-tile]')] : [];
  const titleEl = document.querySelector('[data-hero-title]');
  const enEl = document.querySelector('[data-hero-en]');
  const noteEl = document.querySelector('[data-hero-note]');
  const goEl = document.querySelector('[data-hero-go]');
  const clock = document.querySelector('[data-clock]');

  let current = 0;
  let swapTimer = 0;

  /** 窄屏：轨道自己可以横向滚动（scroll-snap），不再用 transform 推 */
  const narrow = window.matchMedia('(max-width: 900px)');

  /**
   * 只有键盘切换才平移轨道：鼠标悬停时若也平移，
   * 方块会跑到光标底下，连环触发 mouseenter，看起来就是「一路滚到底」。
   * 而且只在真的放不下时才平移，避免露出空白。
   */
  const slide = (tile, allow) => {
    if (!track || !rail || !allow) return 0;
    if (narrow.matches) {
      track.style.transform = '';
      tile.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
      return 0;
    }
    const maxShift = Math.min(0, rail.clientWidth - track.scrollWidth);
    const target = Math.max(maxShift, Math.min(0, -tile.offsetLeft));
    track.style.transform = `translateX(${target}px)`;
    return target;
  };

  const swap = (apply) => {
    if (!hero) {
      apply();
      return;
    }
    hero.classList.add('is-swap');
    clearTimeout(swapTimer);
    swapTimer = window.setTimeout(() => {
      apply();
      hero.classList.remove('is-swap');
    }, 130);
  };

  const select = (index, { animate = true, slideRow = false } = {}) => {
    if (!tiles.length) return;
    const next = (index + tiles.length) % tiles.length;
    if (next === current && animate) return;

    const tile = tiles[next];
    // 只有选中项真的换了才播淡入：首帧、resize 这些"没换内容"的场景直接落字，
    // 不然标题会一直重播淡入（截图里就抓到过标题半透明的状态）
    const changed = next !== current;
    current = next;

    tiles.forEach((t, i) => {
      const was = t.classList.contains('is-on');
      const now = i === current;
      t.classList.toggle('is-on', now);
      if (was && !now) powerOff(t); // 失去选中：CRT 收成一条线
      if (!was && now) powerOn(t); // 拿到选中：开机
    });

    const shift = slide(tile, slideRow);

    // 冷光跟着选中方块的中心走
    if (glow && shell) {
      const box = shell.getBoundingClientRect();
      const rect = tile.getBoundingClientRect();
      glow.style.setProperty('--gx', `${rect.left - box.left + rect.width / 2}px`);
      glow.style.setProperty('--gy', `${rect.top - box.top + rect.height / 2}px`);
    }

    const applyHero = () => {
      if (titleEl) titleEl.textContent = tile.dataset.cn ?? '';
      if (enEl) enEl.textContent = tile.dataset.en ?? '';
      // note 有两套：data-note 是纯文本，data-note-html 带「待导入」的红字标记
      if (noteEl) noteEl.innerHTML = tile.dataset.noteHtml ?? tile.dataset.note ?? '';
      if (goEl) goEl.setAttribute('href', tile.getAttribute('href') ?? '#');
    };

    if (changed) swap(applyHero);
    else applyHero();
  };

  /* ============================================================
     战策经验：数据销毁
     ------------------------------------------------------------
     点它不跳文章页，而是把这格屏"删掉"：递减 → 崩解 → 收线，
     下方打出「权限不足」，再用世界线噪声把字换掉，最后整排左移补位。
     销毁后**不自动选中**任何方向（按 → 才选第一个）。
     ============================================================ */
  const combatTile = tiles.find((t) => (t.getAttribute('href') ?? '') === '/articles/?from=combat') ?? null;
  combatTile?.setAttribute('data-no-xfer', '');
  let destroying = false;

  const sleep = (ms: number) => new Promise<void>((r) => window.setTimeout(r, ms));

  const typeInto = async (el: HTMLElement, text: string, ms = 72): Promise<void> => {
    el.textContent = '';
    for (let i = 1; i <= text.length; i += 1) {
      el.textContent = text.slice(0, i);
      await sleep(ms);
    }
  };

  const updateStat = (): void => {
    const statEl = document.querySelector<HTMLElement>('[data-stat]');
    if (!statEl) return;
    const ready = tiles.filter((t) => t.dataset.ready === '1').length;
    statEl.textContent = `${ready} / ${tiles.length}`;
  };

  const destroyCombat = async (): Promise<void> => {
    if (!combatTile || destroying) return;
    destroying = true;
    combatTile.setAttribute('aria-disabled', 'true');
    combatTile.style.pointerEvents = 'none';

    /* 先把选中挪到这一格：不然下方写的是别的方向的名字，点它却把它销毁了 */
    const at = tiles.indexOf(combatTile);
    if (at >= 0 && at !== current) {
      select(at, { animate: false });
      await sleep(160);
    }

    /* 第 1–3 幕：递减 + 崩解 + 收线 */
    await dissolveTile(combatTile, { count: Number(combatTile.dataset.count) || 0 });

    /* 下方：权限不足（打字机） */
    if (titleEl) await typeInto(titleEl, t('works.combat.denied', '权限不足'));
    if (enEl) enEl.textContent = t('works.combat.restricted', 'RESTRICTED');
    if (noteEl) noteEl.textContent = '';
    if (goEl) goEl.hidden = true;

    await sleep(140);

    /* 第 4 幕：世界线噪声替换 —— 噪声最密时把字清空 */
    if (hero) {
      await worldlineSwap(hero, {
        swap: () => {
          if (titleEl) titleEl.textContent = '';
          if (enEl) enEl.textContent = '';
          if (noteEl) noteEl.textContent = '';
        },
      });
    }

    /* 左移补位：剩下的从旧位置滑到新位置 */
    const rest = tiles.filter((tile) => tile !== combatTile);
    await removeAndShift(combatTile, rest);

    /* 不选中任何方向；把数组和计数更新掉 */
    for (const tile of rest) tile.classList.remove('is-on');
    current = -1;
    const gone = tiles.indexOf(combatTile);
    if (gone >= 0) tiles.splice(gone, 1);
    updateStat();

    /* 没有选中项了：把轨道和 hero 一起收干净 */
    document.querySelector('.ws-rail')?.classList.add('no-selection');
    document.querySelector('.ws-hero')?.classList.add('is-empty');
    if (goEl) goEl.hidden = true;
    document.querySelector<HTMLElement>('.ws-more')?.setAttribute('hidden', '');

    /* 剩下的重新编号（CH 03 → CH 02 …），像它从来没存在过 */
    for (const [k, tile] of tiles.entries()) {
      const num = tile.querySelector<HTMLElement>('.ws-num');
      if (num) num.textContent = String(k + 1).padStart(2, '0');
    }

    if (combatTile) combatTile.remove();
  };


  for (const [i, tile] of tiles.entries()) {
    // 鼠标移到哪块，哪块就选中（变大 + 开机，其余关掉）；
    // 键盘 Tab 聚焦同样算选中；点一下也是（触屏没有 hover）。
    // 存档态下这条规则换人管：方块成了频道条，悬停/点击 = 切卡片，不碰 hero。
    tile.addEventListener('mouseenter', () => {
      // 存档态：顶部那排是「五个方向」，不是这 5 条视频的选择器 —— 悬停不切卡片
      if (shell?.classList.contains('is-vfx')) return;
      select(i);
    });
    tile.addEventListener('focus', () => {
      if (shell?.classList.contains('is-vfx')) return;
      select(i);
    });
    tile.addEventListener('click', (event) => {
      // 存档态：点另一个方向 = 换频道。先退出存档，再按它自己的规则走
      if (shell?.classList.contains('is-vfx')) {
        const nextHref = tile.getAttribute('href') ?? '';
        setVfx(false);
        if (nextHref.startsWith('#')) {
          event.preventDefault();
          select(i);
        }
        return;
      }
      // 战策经验：不跳转，走"数据销毁"（见 destroyCombat）
      if (tile === combatTile) {
        event.preventDefault();
        void destroyCombat();
        return;
      }
      // 有真地址的（比如 AI 功能 → /works/ai/）让它正常跳过去，
      // 只有还没内容、href 是 "#id" 的占位块才拦下来，只切选中。
      const href = tile.getAttribute('href') ?? '';
      if (href.startsWith('#')) {
        event.preventDefault();
        select(i);
      }
    });
  }

  /* 老电视：鼠标进入方块 = 换台（白闪 + 撕裂 + 咔哒），实现见 scripts/crt-tv.ts */
  attachCrt();

  window.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowRight') {
      if (shell?.classList.contains('is-vfx')) return; // 存档态的 ←→ 归卡片管
      event.preventDefault();
      select(current + 1, { slideRow: true });
    }
    if (event.key === 'ArrowLeft') {
      if (shell?.classList.contains('is-vfx')) return;
      event.preventDefault();
      select(current - 1, { slideRow: true });
    }
    if (event.key === 'Enter' && !shell?.classList.contains('is-vfx')) {
      tiles[current]?.click();
    }
  });

  window.addEventListener('resize', () => {
    // 存档态下顶部是「方向」，别让 resize 把选中抢回第一个
    if (shell?.classList.contains('is-vfx')) return;
    if (tiles[current]) select(current, { animate: false, slideRow: false });
  });

  const tick = () => {
    if (!clock) return;
    const now = new Date();
    clock.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
  };
  tick();
  window.setInterval(tick, 30_000);

  /* ============================================================
     就地展开的存档层（XMB）
     ------------------------------------------------------------
     行为全部走 scripts/archive.ts，这一页只做接线：
     哪个方块开哪个频道、频道条怎么高亮、面包屑补什么字。
     ============================================================ */
  const channels = JSON.parse(
    document.querySelector<HTMLScriptElement>('[data-archive-channels]')?.textContent ?? '{}',
  );

  /* href 是 #xxx 的方块 = 就地展开；真地址的（战策经验 / AI 功能）正常跳转 */
  const channelOf = (tile: HTMLElement): string | null => {
    const href = tile.getAttribute('href') ?? '';
    if (!href.startsWith('#')) return null;
    const id = href.slice(1);
    return channels[id] ? id : null;
  };

  const archive = initArchive({
    root: shell as HTMLElement | null,
    grid: document.querySelector<HTMLElement>('[data-vfx-track]'),
    pageSize: 4,
    pager: document.querySelector<HTMLElement>('[data-pager]'),
    focus: document.querySelector<HTMLElement>('[data-vfx-focus]'),
    bgLayers: [
      document.querySelector<HTMLElement>('[data-vfx-bg]'),
      document.querySelector<HTMLElement>('[data-vfx-bg2]'),
    ].filter(Boolean) as HTMLElement[],
    legend: document.querySelector<HTMLElement>('.ws-vfx-legend'),
    crumbs: (() => {
      const host = document.querySelector<HTMLElement>('.crumbs');
      if (!host) return null;
      return {
        host,
        html: (channel) =>
          '<span class="sep" aria-hidden="true">/</span><span class="here">' +
          (channel.title ?? t('works.archive.title', '特效作品存档')) +
          '</span>',
      };
    })(),
    player: (() => {
      const box = document.querySelector<HTMLElement>('[data-player]');
      const video = document.querySelector<HTMLVideoElement>('[data-player-video]');
      return box && video ? { box, video } : null;
    })(),
    channels,
    urlParam: 'ch',
    emptyText: t('works.empty', '还没有内容'),
    /* 存档态：顶部那排是「五个方向」，选中永远是当前那个方向 */
    onToggle: (_open, channel) => {
      const i = tiles.findIndex((tile) => channelOf(tile) === channel.id);
      if (i >= 0) select(i, { animate: false });
    },
  });

  for (const [i, tile] of tiles.entries()) {
    /* 就地展开的方块：不走转场，点它开存档 */
    if (channelOf(tile)) tile.setAttribute('data-no-xfer', '');

    tile.addEventListener('click', (event) => {
      const id = channelOf(tile);
      if (id) {
        event.preventDefault();
        archive.open(id);
        return;
      }
      /* 存档态下点别的方向 = 换频道：先退出存档，再按它自己的规则走 */
      if (archive.opened) {
        archive.close();
        const href = tile.getAttribute('href') ?? '';
        if (href.startsWith('#')) {
          event.preventDefault();
          select(i);
        }
      }
    });
  }
</script>
