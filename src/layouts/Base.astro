---
import { getEntry } from 'astro:content';
import '../styles/global.css';
import '../styles/xfer.css';
import { SITE, GOATCOUNTER } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 加到 <body> 上的额外 class，用来切换整站配色（如简易模式） */
  bodyClass?: string;
  /** 覆盖 <main> 的 class，默认是 wrap（限宽居中） */
  mainClass?: string;
  /** 为 true 时不显示右上角导航 */
  hideNav?: boolean;
  /** 为 true 时告诉搜索引擎别收录这一页 */
  noindex?: boolean;
  /** 面包屑最后一段要显示的名字（动态页用：项目名、文章名……） */
  crumbLast?: string;
}

const {
  title = SITE.title,
  description = SITE.intro,
  bodyClass = '',
  mainClass = 'wrap',
  hideNav = false,
  noindex = false,
  crumbLast = '',
} = Astro.props;
const path = Astro.url.pathname;
const year = new Date().getFullYear();

// 首页是「有趣」界面（/）。/home/ 那个简易首页已经删了，主页只有一个落点。
const isFunRoute = path === '/';
// 「沉浸页」：从有趣主页点进来、自己撑满一屏的页面。
// 左上角从「简易」换成「返回」（点回主页），右上角的站内导航整体收起来。
const IMMERSIVE = ['/brief/', '/works/', '/articles/', '/abyss/'];
const here = path.endsWith('/') ? path : `${path}/`;
// 前缀匹配，所以 /articles/ 下的子页也自动算沉浸页
const isImmersive = IMMERSIVE.some((p) => here === p || here.startsWith(p));

// 左上角「返回」要回上一级，而不是一路跳回首页：
// /articles/combat/ → /articles/，/works/xxx/ → /works/
const parentHref =
  here.startsWith('/articles/') && here !== '/articles/'
    ? '/articles/'
    : here.startsWith('/works/') && here !== '/works/'
      ? '/works/'
      : '/';

const toggleHref = isFunRoute ? '/works/' : parentHref;
const toggleLabel = isFunRoute ? '作品' : '返回';
const toggleAria = isFunRoute ? '去看作品' : '返回上一级';

// 背景音乐设置来自 src/content/settings/settings.md
const settings = await getEntry('settings', 'settings');
const bgmSrc = settings?.data.bgm?.trim() ?? '';
const bgmVolume = Math.min(100, Math.max(0, settings?.data.bgmVolume ?? 35)) / 100;

const navItems = [
  { label: '作品', href: '/works/' },
  { label: '关于', href: '/about/' },
];

const isActive = (href: string) => path.startsWith(href);
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;

/* ------------------------------------------------------------------
 * 面包屑：返回按钮右边那串 「首页 / 作品 / AI 功能 / 背诵卡片」
 * 路径自动拆，中文名从下面这张表拿；动态末段（比如项目 slug）用 Base 的 crumbLast 传。
 * ------------------------------------------------------------------ */
const CRUMB_LABELS: Record<string, string> = {
  brief: '简介',
  works: '作品',
  articles: '文章',
  about: '联系',
  abyss: '阿比斯',
  ai: 'AI 功能',
  combat: '战斗拆解',
  assets: '素材',
  play: '试玩',
  dive: '下潜',
};

const crumbParts = here.split('/').filter(Boolean);
const crumbs = crumbParts.map((seg, i) => {
  const last = i === crumbParts.length - 1;
  return {
    label: last && crumbLast ? crumbLast : (CRUMB_LABELS[seg] ?? decodeURIComponent(seg)),
    // 最后一段是当前页，不给链接
    href: last ? '' : `/${crumbParts.slice(0, i + 1).join('/')}/`,
  };
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 构建时间戳：排查「改了没生效」时，F12 里搜 dsh-build 就知道手上是不是最新那版 */}
    <meta name="dsh-build" content={new Date().toISOString()} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* noai / noimageai 是非标准标记，愿意遵守的爬虫会读；真正的拦截在 robots.txt */}
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow, noai, noimageai' : 'index, follow, noai, noimageai'}
    />
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!--
      换页转场：抵达页要在首帧就把黑幕铺满，否则换页那一下会白闪。
      出发端在 src/scripts/xfer.ts，到达端的揭幕也在那里（xferIn）。
    -->
    <script is:inline>
      (function () {
        try {
          // 调试用：?xfer=connect|scan|slide|soft 可以单独看某一档的到达动画
          var forced = /[?&]xfer=(connect|scan|slide|soft)/.exec(location.search);
          var kind = forced ? forced[1] : sessionStorage.getItem('xf-kind');
          if (!kind) return;
          var root = document.documentElement;
          root.classList.add('xf-entering', 'xf-' + kind);
          // 兜底：转场脚本没跑起来也不会一直黑着
          window.setTimeout(function () {
            root.classList.remove(
              'xf-entering',
              'xf-run',
              'xf-connect',
              'xf-scan',
              'xf-slide',
              'xf-soft',
            );
            sessionStorage.removeItem('xf-kind');
          }, 2200);
        } catch (e) {
          /* 隐私模式：按普通加载处理 */
        }
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121213" media="(prefers-color-scheme: dark)" />

    {/* 访问统计：在 src/consts.ts 里填了 GOATCOUNTER 才加载，留空则一个字节都不发 */}
    {
      GOATCOUNTER && (
        <script
          is:inline
          data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>

  <body class={bodyClass}>
    <!-- 换页转场幕布：必须在 body 最前面，首帧就要盖住，晚一帧就会闪 -->
    <div id="xfer" class="xfer" aria-hidden="true">
      <span class="xfer-slices"><i></i><i></i><i></i><i></i></span>
      <span class="xfer-band"></span>
      <span class="xfer-edge"></span>
    </div>

    <script>
      // 换页转场：xferIn 揭开上一页留下的幕布，bindXfer 给所有站内链接接上出发动画
      import { xferIn, bindXfer, bindXferLifecycle } from '../scripts/xfer';
      import { attachSfx } from '../scripts/sfx';

      xferIn();
      bindXfer();
      bindXferLifecycle();
      attachSfx();
    </script>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="mode-toggle" href={toggleHref} aria-label={toggleAria}>
          {toggleLabel}
        </a>
        {
          crumbs.length > 0 && (
            <nav class="crumbs" aria-label="位置">
              <a href="/">首页</a>
              {crumbs.map((c) => (
                <>
                  <span class="sep" aria-hidden="true">
                    /
                  </span>
                  {c.href ? (
                    <a href={c.href}>{c.label}</a>
                  ) : (
                    <span class="here" aria-current="page">
                      {c.label}
                    </span>
                  )}
                </>
              ))}
            </nav>
          )
        }
        <nav class="nav" aria-label="主导航">
          {
            !hideNav &&
              !isImmersive &&
              navItems.map((item) => (
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
          }
          {
            bgmSrc && (
              <div class="sound-control">
                <button
                  type="button"
                  class="sound-toggle"
                  id="sound-toggle"
                  data-on="false"
                  data-src={bgmSrc}
                  data-volume={bgmVolume}
                  aria-expanded="false"
                  aria-controls="sound-panel"
                  aria-label="声音设置"
                  title="声音设置"
                >
                  <span class="sound-wave" aria-hidden="true" />
                  <span class="sound-wave" aria-hidden="true" />
                  <svg data-icon="off" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
                    <path d="M16.5 8.5l5 5m0-5l-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
                  </svg>
                  <svg data-icon="on" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
                    <path d="M16.5 8.2a5 5 0 0 1 0 7.6M19 5.8a8.5 8.5 0 0 1 0 12.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
                  </svg>
                </button>

                <div class="sound-panel" id="sound-panel" hidden>
                  <label class="sound-row">
                    <span class="sound-row-label">音效</span>
                    <input class="sound-range" id="sfx-volume" type="range" min="0" max="100" step="1" />
                    <b class="sound-row-value" data-sfx-value>75</b>
                  </label>
                  <label class="sound-row">
                    <span class="sound-row-label">音乐</span>
                    <input class="sound-range" id="bgm-volume" type="range" min="0" max="100" step="1" />
                    <b class="sound-row-value" data-bgm-value>0</b>
                  </label>
                </div>
              </div>
            )
          }
        </nav>
      </div>
    </header>

    <main class={mainClass}>
      <slot />
    </main>

    {/* 页脚（© 年份 + 社交链接）已经撤掉：主界面和子界面都按「一屏」做，
        底下再挂一行重复信息会把页面撑出滚动条，看起来就跟普通网页没两样了。
        联系方式只留在 /about/ 那一页。 */}

    <script>
      /*
       * 声音设置：右上角那个圆钮现在只管「打开设置面板」，真正的开关在面板里的两条滑杆上。
       *   · 音效 —— 控制界面音效（sfx.ts 的主音量），默认 75
       *   · 音乐 —— 控制背景音乐，默认 0（也就是关着）
       * 两个值都记在 localStorage，翻页后保持。
       *
       * 浏览器禁止带声音的自动播放，所以音乐滑杆拉起来时才算一次用户手势，
       * 那一刻调用 play() 是允许的；如果是刷新后恢复音量，play 可能被拦，
       * 就先挂着，等第一次点按再补上。
       */
      import { setSfxVolume } from '../scripts/sfx';
      import { attachBgmBeat } from '../scripts/bgm-beat';

      const btn = document.getElementById('sound-toggle');

      if (btn) {
        const panel = document.getElementById('sound-panel');
        const sfxInput = document.getElementById('sfx-volume') as HTMLInputElement | null;
        const bgmInput = document.getElementById('bgm-volume') as HTMLInputElement | null;
        const sfxOut = document.querySelector('[data-sfx-value]');
        const bgmOut = document.querySelector('[data-bgm-value]');

        const audio = new Audio();
        audio.src = btn.dataset.src || '';
        audio.loop = true;
        audio.preload = 'none';
        // 节拍检测：音乐真的开起来之后，才把 <audio> 接进 Web Audio 量低频
        attachBgmBeat(audio);

        const SFX_KEY = 'sfx-volume';
        const BGM_KEY = 'bgm-volume';
        const SFX_DEFAULT = 75;
        const BGM_DEFAULT = 0;

        const clamp = (n: number): number => Math.min(100, Math.max(0, Math.round(n)));
        const read = (key: string, fallback: number): number => {
          try {
            const raw = localStorage.getItem(key);
            if (raw === null) return fallback;
            const n = Number(raw);
            return Number.isNaN(n) ? fallback : clamp(n);
          } catch {
            return fallback;
          }
        };
        const write = (key: string, value: number): void => {
          try {
            localStorage.setItem(key, String(value));
          } catch {
            /* 隐私模式存不了，本次会话内有效 */
          }
        };

        // 老版本只存了「开/关」，迁过来
        let legacyOn = false;
        try {
          legacyOn = localStorage.getItem('bgm-on') === '1';
        } catch {
          legacyOn = false;
        }

        let sfxValue = read(SFX_KEY, SFX_DEFAULT);
        let bgmValue = read(BGM_KEY, legacyOn ? 35 : BGM_DEFAULT);

        const render = (): void => {
          const musicOn = bgmValue > 0;
          btn.dataset.on = String(musicOn);
          btn.setAttribute('aria-label', musicOn ? '声音设置（音乐开）' : '声音设置（音乐关）');
          btn.title = btn.getAttribute('aria-label') || '';
          // 音乐关着就一直招呼两下，开了就安静
          btn.classList.toggle('is-calling', !musicOn);
          if (sfxOut) sfxOut.textContent = String(sfxValue);
          if (bgmOut) bgmOut.textContent = String(bgmValue);
          if (sfxInput) sfxInput.value = String(sfxValue);
          if (bgmInput) bgmInput.value = String(bgmValue);
        };

        const applySfx = (): void => {
          setSfxVolume(sfxValue / 100);
        };

        const play = async (): Promise<void> => {
          try {
            await audio.play();
          } catch {
            // 还没拿到用户手势，等第一次点按再补
          }
        };

        const applyBgm = (): void => {
          audio.volume = bgmValue / 100;
          if (bgmValue > 0) void play();
          else audio.pause();
        };

        applySfx();
        applyBgm();
        render();

        // 音量恢复后 play 常被拦，第一次点按补一次
        const retry = (): void => {
          if (bgmValue > 0 && audio.paused) void play();
        };
        window.addEventListener('pointerdown', retry, { once: true });
        window.addEventListener('keydown', retry, { once: true });

        sfxInput?.addEventListener('input', () => {
          sfxValue = clamp(Number(sfxInput.value));
          applySfx();
          write(SFX_KEY, sfxValue);
          render();
          // 拖动时给个即时反馈
          setSfxVolume(sfxValue / 100);
        });

        bgmInput?.addEventListener('input', () => {
          bgmValue = clamp(Number(bgmInput.value));
          applyBgm();
          write(BGM_KEY, bgmValue);
          render();
        });

        const setOpen = (open: boolean): void => {
          btn.setAttribute('aria-expanded', String(open));
          if (panel) panel.hidden = !open;
          if (open) btn.classList.remove('is-calling');
          else if (bgmValue === 0) btn.classList.add('is-calling');
        };

        btn.addEventListener('click', (event) => {
          event.stopPropagation();
          setOpen(btn.getAttribute('aria-expanded') !== 'true');
        });

        document.addEventListener('click', (event) => {
          if (panel && !panel.hidden && !panel.contains(event.target as Node)) setOpen(false);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && panel && !panel.hidden) setOpen(false);
        });
      }
    </script>
  </body>
</html>
