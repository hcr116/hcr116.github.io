---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, SKILLS, TIMELINE, WECHAT } from '../consts';

// 自述正文在 src/content/about/about.md，可以直接编辑那个文件
const aboutEntry = await getEntry('about', 'about');
const AboutContent = aboutEntry ? (await render(aboutEntry)).Content : null;
---

<Base title={`关于 · ${SITE.name}`} description={`关于 ${SITE.name}`}>
  <header class="about-header">
    <p class="eyebrow">关于</p>
    <h1>{SITE.tagline}</h1>
  </header>

  <section class="about-block">
    <h2>自述</h2>
    <div class="prose" style="padding-block: 0;">
      {AboutContent ? <AboutContent /> : <p>还没有写自述。</p>}
    </div>
  </section>

  {
    SKILLS.length > 0 && (
      <section class="about-block">
        <h2>能力</h2>
        <div class="skill-groups">
          {SKILLS.map((group) => (
            <div class="skill-group" data-level={group.level}>
              <h3>{group.group}</h3>
              <ul class="chips">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    TIMELINE.length > 0 && (
      <section class="about-block">
        <h2>经历</h2>
        <dl class="timeline">
          {TIMELINE.map((item) => (
            <div class="timeline-item">
              <dt>{item.year}</dt>
              <dd>
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="about-block">
    <h2>联系</h2>
    <div class="contact-list">
      <a href={`mailto:${SITE.email}`}>
        <span>{SITE.email}</span>
        <span class="contact-label">邮件</span>
      </a>
      {
        SITE.links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener">
            <span>{link.href.replace(/^https?:\/\//, '')}</span>
            <span class="contact-label">{link.label}</span>
          </a>
        ))
      }
    </div>

    <div class="wechat-card">
      <img
        src={WECHAT.qr}
        alt={`微信公众号「${WECHAT.name}」二维码`}
        width="180"
        height="180"
        loading="lazy"
        decoding="async"
      />
      <div class="wechat-meta">
        <p class="wechat-name">公众号 · {WECHAT.name}</p>
        <p class="wechat-note">{WECHAT.note}</p>
      </div>
    </div>
  </section>
</Base>
