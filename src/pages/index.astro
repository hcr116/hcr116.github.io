---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';

// 副标题和简介可以在后台「首页 · 文案」里改
const home = await getEntry('home', 'home');
const role = home?.data.subtitle || '动作游戏战斗策划';

const menu = [
  { label: '简介', en: 'BRIEF', href: '/about/' },
  { label: '作品', en: 'WORKS', href: '/home/' },
  { label: '时间线', en: 'TIMELINE', href: '/timeline/' },
  { label: '联系', en: 'CONTACT', href: `mailto:${SITE.email}` },
];

const social = [
  ...SITE.links.map((l) => ({ label: l.label.split(' · ')[0], href: l.href })),
  { label: '公众号', href: '/about/' },
];
---

<Base
  title={SITE.title}
  description={SITE.intro}
  bodyClass="mode-fun"
  mainClass="fun-main"
  hideNav
>
  <section class="fun-stage">
    <div class="fun-glow" aria-hidden="true"></div>

    <div class="fun-lead">
      <p class="fun-eyebrow">HI I'M</p>
      <h1 class="fun-name">{SITE.cnName}</h1>

      <p class="fun-role">
        <span class="fun-mark" aria-hidden="true"></span>
        <span>{role}</span>
      </p>

      <nav class="fun-menu" aria-label="主导航">
        {
          menu.map((item, i) => (
            <a href={item.href}>
              <span class="fun-menu-idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="fun-menu-cn">{item.label}</span>
              <em>{item.en}</em>
            </a>
          ))
        }
      </nav>

      <div class="fun-social">
        {
          social.map((item) => (
            <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              {item.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="fun-art" aria-hidden="true">
      <svg class="emblem" viewBox="0 0 400 400" role="presentation">
        <circle cx="200" cy="200" r="178" fill="none" stroke="#26262e" stroke-width="1" />
        <circle cx="200" cy="200" r="152" fill="none" stroke="#2b2b34" stroke-width="1.5" stroke-dasharray="2 10" />

        <g class="emblem-spin">
          <circle
            cx="200"
            cy="200"
            r="128"
            fill="none"
            stroke="currentColor"
            stroke-opacity="0.6"
            stroke-width="1.5"
            stroke-dasharray="34 16"
          />
          <circle cx="200" cy="72" r="5.5" fill="currentColor" />
        </g>

        <g class="emblem-spin-reverse">
          <circle
            cx="200"
            cy="200"
            r="100"
            fill="none"
            stroke="#6b6975"
            stroke-opacity="0.6"
            stroke-width="1"
            stroke-dasharray="1 12"
          />
          <circle cx="100" cy="200" r="3" fill="currentColor" fill-opacity="0.75" />
        </g>

        <circle cx="200" cy="200" r="78" fill="#1b1b22" stroke="#34343f" stroke-width="1.5" />
        <circle cx="200" cy="200" r="46" fill="none" stroke="currentColor" stroke-opacity="0.8" stroke-width="1.5" />
        <circle cx="200" cy="200" r="11" fill="currentColor" />
      </svg>
    </div>
  </section>

  <p class="fun-caption">
    这个页面刚开始搭，后面会往里塞点好玩的东西<span class="fun-caret" aria-hidden="true"></span>
  </p>
</Base>
